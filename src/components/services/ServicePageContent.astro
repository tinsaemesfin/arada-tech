---
import type { Service } from '@data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const iconPaths: Record<string, string> = {
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
};
---

<!-- Service Hero -->
<section class="section-padding pb-0">
  <div class="section-container max-w-4xl">
    <div class="flex items-center gap-4 mb-6 reveal-up">
      <div class="w-14 h-14 rounded-2xl bg-primary-50 flex items-center justify-center">
        <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[service.icon]} />
        </svg>
      </div>
    </div>
    <h1 class="heading-xl mb-6 reveal-up">{service.title}</h1>
    <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed max-w-3xl reveal-up">{service.tagline}</p>
  </div>
</section>

<!-- Description -->
<section class="section-gap">
  <div class="section-padding">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div class="reveal-left">
          <h2 class="heading-md mb-6">What We Deliver</h2>
          <p class="prose-content mb-8">{service.description}</p>
          <a href="/contact/" class="btn-primary btn-lg">Discuss Your Project</a>
        </div>

        <div class="reveal-right">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {service.features.map((feature) => (
              <div class="flex items-start gap-3 p-4 rounded-xl bg-neutral-50">
                <svg class="w-5 h-5 text-secondary-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm font-medium text-neutral-800">{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Process -->
<section class="section-gap bg-neutral-50">
  <div class="section-padding">
    <div class="section-container">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-up">
        <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">Our Process</span>
        <h2 class="heading-lg">How We Work on {service.shortTitle} Projects</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-children">
        {service.process.map((step) => (
          <div class="relative text-center">
            <div class="w-14 h-14 rounded-2xl bg-primary-500 text-white flex items-center justify-center mx-auto mb-5">
              <span class="font-display font-bold text-lg">{step.step}</span>
            </div>
            <h3 class="font-bold text-neutral-900 mb-2">{step.title}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Technologies -->
<section class="section-gap">
  <div class="section-padding">
    <div class="section-container text-center">
      <h2 class="heading-md mb-8 reveal-up">Technologies We Use</h2>
      <div class="flex flex-wrap justify-center gap-3 stagger-children">
        {service.technologies.map((tech) => (
          <span class="px-5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-full text-sm font-medium text-neutral-700 hover:border-primary-300 hover:text-primary-500 transition-colors">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section-gap bg-neutral-50">
  <div class="section-padding">
    <div class="section-container max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal-up">
        <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">FAQ</span>
        <h2 class="heading-lg">Common Questions About {service.shortTitle}</h2>
      </div>

      <div class="space-y-4 stagger-children">
        {service.faqs.map((faq, index) => (
          <details class="group card" id={`faq-${index}`}>
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <h3 class="font-bold text-neutral-900 pr-8">{faq.question}</h3>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="mt-4 text-neutral-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
