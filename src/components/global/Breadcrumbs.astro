---
interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems = [{ name: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="section-padding pt-2 pb-2 sm:pt-3 sm:pb-3 lg:py-4">
  <div class="section-container">
    <ol class="flex items-center gap-2 text-sm text-neutral-500 flex-wrap">
      {allItems.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {index === allItems.length - 1 ? (
            <span class="text-neutral-900 font-medium" aria-current="page">{item.name}</span>
          ) : (
            <a href={item.href} class="hover:text-primary-500 transition-colors">{item.name}</a>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
