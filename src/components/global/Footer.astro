  },
  {
    url: company.social.github,
    label: 'GitHub',
    path: 'M12 2C6.477 2 2 6.477 2 12c0 4.418 2.867 8.167 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.699-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.463-1.11-1.463-.908-.621.069-.609.069-.609 1.003.071 1.531 1.03 1.531 1.03.892 1.529 2.341 1.089 2.91.834.092-.654.35-1.089.637-1.34-2.22-.251-4.556-1.111-4.556-4.943 0-1.091.389-1.984 1.029-2.682-.103-.251-.446-1.261.097-2.628 0 0 .84-.27 2.749 1.026A9.564 9.564 0 0112 6.836c.85.004 1.705.115 2.504.337 1.908-1.297 2.747-1.026 2.747-1.026.546 1.367.203 2.378.098 2.628.642.698 1.028 1.591 1.028 2.682 0 3.842-2.339 4.689-4.566 4.936.358.309.677.917.677 1.852 0 1.335-.013 2.415-.013 2.743 0 .267.179.579.681.478C21.138 20.167 24 16.418 24 12c0-5.523-4.478-10-10-10z',
  },
];

const visibleSocial = socialIcons.filter((s) => Boolean(s.url));
---

<footer class="bg-neutral-950 text-white">
  <!-- Main Footer -->
  <div class="section-padding section-gap">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
        <!-- Brand Column -->
        <div>
          <a href="/" class="inline-flex mb-6 group">
            <img
              src={brandAssets.fullLogo}
              alt={`${company.name} logo`}
              width="200"
              height="48"
              class="h-9 w-auto max-w-[11rem] object-contain object-left opacity-95 group-hover:opacity-100 transition-opacity"
              loading="lazy"
            />
          </a>
          <p class="text-neutral-400 text-sm leading-relaxed mb-6">
            {company.description}
          </p>
          <div class="flex flex-wrap gap-3">
            {visibleSocial.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-lg bg-neutral-800 flex items-center justify-center text-neutral-400 hover:bg-primary-500 hover:text-white transition-all"
                aria-label={s.label}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path}/></svg>
              </a>
            ))}
          </div>
        </div>

        <nav class="md:col-span-2 lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-8" aria-label="Footer navigation">
        <!-- Services Column -->
        <div>
          <h3 class="font-display font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Services</h3>
          <ul class="flex flex-col gap-3">
            {footerNav.services.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-neutral-300 hover:text-secondary-400 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Company Column -->
        <div>
          <h3 class="font-display font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Company</h3>
          <ul class="flex flex-col gap-3">
            {footerNav.company.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-neutral-300 hover:text-secondary-400 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact Column -->
        <div>
          <h3 class="font-display font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Contact</h3>
          <ul class="flex flex-col gap-4">
            <li>
              <a href={`tel:${company.phoneRaw}`} class="flex items-start gap-3 text-sm text-neutral-300 hover:text-secondary-400 transition-colors group">
                <svg class="w-4 h-4 mt-0.5 text-secondary-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                {company.phone}
              </a>
            </li>
            <li><EmailContact variant="row" /></li>
            <li>
              <address class="flex items-start gap-3 text-sm text-neutral-300 not-italic">
                <svg class="w-4 h-4 mt-0.5 text-secondary-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span>{company.name}, {company.address.street}, {company.address.city}, {company.address.country}</span>
              </address>
            </li>
          </ul>
        </div>
        </nav>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-neutral-800">
    <div class="section-padding">
      <div class="section-container flex flex-col sm:flex-row items-center justify-between gap-4 py-6">
        <p class="text-xs text-neutral-500">
          &copy; {currentYear} {company.name}. All rights reserved.
        </p>
        <div class="flex gap-6">
          {footerNav.legal.map((link) => (
            <a href={link.href} class="text-xs text-neutral-500 hover:text-neutral-300 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
