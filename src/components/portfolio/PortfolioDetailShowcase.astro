---
import PortfolioLaptopMockup from '@components/portfolio/PortfolioLaptopMockup.astro';

interface Props {
  slug: string;
  title: string;
  coverImage: string;
}

const { slug, title, coverImage } = Astro.props;
---

<div class="portfolio-showcase-stage" data-portfolio-intro={slug}>
  <div class="portfolio-showcase-ambient portfolio-showcase-ambient--left" data-portfolio-ambient aria-hidden="true"></div>
  <div class="portfolio-showcase-ambient portfolio-showcase-ambient--right" data-portfolio-ambient aria-hidden="true"></div>
  <div class="portfolio-showcase-grid" data-portfolio-grid aria-hidden="true"></div>
  <div class="portfolio-showcase-beam" data-portfolio-beam aria-hidden="true"></div>

  <div class="portfolio-showcase-shell">
    <div class="portfolio-showcase-label" data-portfolio-label aria-hidden="true">Guided case study reveal</div>

    <div class="portfolio-showcase-device" data-portfolio-stage>
      <PortfolioLaptopMockup
        src={coverImage}
        alt={`${title} — product screenshot`}
        priority
        class="portfolio-showcase-device-media"
      />
    </div>
  </div>

  <div class="portfolio-showcase-cue" data-portfolio-scroll-cue aria-hidden="true">
    <span class="portfolio-showcase-cue__label">Scroll preview</span>
    <span class="portfolio-showcase-cue__track">
      <span class="portfolio-showcase-cue__dot"></span>
    </span>
  </div>
</div>

<style>
  :global([data-portfolio-target]) {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .portfolio-showcase-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
    min-height: min(82vh, 48rem);
    padding: clamp(1rem, 2.5vw, 2rem);
    border-radius: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid rgba(148, 163, 184, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 250, 252, 0.95) 50%, rgba(241, 245, 249, 0.92) 100%);
    box-shadow:
      0 32px 90px -48px rgba(15, 23, 42, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .portfolio-showcase-shell {
    position: relative;
    z-index: 2;
    min-width: 0;
    min-height: inherit;
    display: grid;
    align-content: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .portfolio-showcase-label {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: min(100%, 30rem);
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.56);
    backdrop-filter: blur(18px);
    color: rgba(42, 53, 125, 0.92);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-align: center;
    text-transform: uppercase;
    box-shadow: 0 18px 40px -32px rgba(15, 23, 42, 0.85);
  }

  .portfolio-showcase-label::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(42, 53, 125, 1) 0%, rgba(239, 123, 34, 1) 100%);
    box-shadow: 0 0 0 0.35rem rgba(42, 53, 125, 0.08);
  }

  .portfolio-showcase-device {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 100%;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .portfolio-showcase-device::after {
    content: '';
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: -4%;
    height: 18%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.2) 0%, rgba(15, 23, 42, 0.08) 40%, transparent 75%);
    filter: blur(20px);
    z-index: 0;
    pointer-events: none;
  }

  .portfolio-showcase-device-media {
    position: relative;
    z-index: 1;
  }

  .portfolio-showcase-ambient,
  .portfolio-showcase-grid,
  .portfolio-showcase-beam {
    pointer-events: none;
  }

  .portfolio-showcase-ambient {
    position: absolute;
    width: clamp(18rem, 34vw, 30rem);
    height: clamp(18rem, 34vw, 30rem);
    border-radius: 999px;
    filter: blur(16px);
    opacity: 0.85;
    z-index: 0;
  }

  .portfolio-showcase-ambient--left {
    top: -18%;
    left: -9%;
    background: radial-gradient(circle, rgba(42, 53, 125, 0.24) 0%, rgba(42, 53, 125, 0.1) 36%, transparent 72%);
    animation: portfolio-ambient-float-left 12s ease-in-out infinite alternate;
  }

  .portfolio-showcase-ambient--right {
    right: -12%;
    bottom: -26%;
    background: radial-gradient(circle, rgba(239, 123, 34, 0.24) 0%, rgba(239, 123, 34, 0.1) 36%, transparent 72%);
    animation: portfolio-ambient-float-right 15s ease-in-out infinite alternate;
  }

  .portfolio-showcase-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    opacity: 0.55;
    background-image:
      linear-gradient(rgba(42, 53, 125, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(42, 53, 125, 0.08) 1px, transparent 1px);
    background-size: clamp(2.75rem, 7vw, 4.25rem) clamp(2.75rem, 7vw, 4.25rem);
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 1) 16%, rgba(0, 0, 0, 0) 82%);
    animation: portfolio-grid-drift 20s linear infinite;
  }

  .portfolio-showcase-beam {
    position: absolute;
    left: 50%;
    top: 10%;
    z-index: 1;
    width: min(70vw, 34rem);
    height: min(72vh, 34rem);
    transform: translateX(-50%);
    clip-path: polygon(48% 0, 52% 0, 100% 100%, 0 100%);
    background: linear-gradient(180deg, rgba(42, 53, 125, 0.3) 0%, rgba(42, 53, 125, 0.1) 46%, rgba(255, 255, 255, 0) 100%);
    filter: blur(9px);
    opacity: 0.75;
  }

  .portfolio-showcase-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    transform: translateX(-50%);
    color: rgba(15, 23, 42, 0.74);
    pointer-events: none;
  }

  .portfolio-showcase-cue__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .portfolio-showcase-cue__track {
    display: flex;
    width: 2rem;
    height: 4.5rem;
    padding: 0.35rem;
    border-radius: 999px;
    border: 1px solid rgba(42, 53, 125, 0.18);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0.24) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .portfolio-showcase-cue__dot {
    width: 100%;
    height: 1rem;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(42, 53, 125, 1) 0%, rgba(239, 123, 34, 1) 100%);
    box-shadow: 0 8px 24px rgba(42, 53, 125, 0.28);
    animation: portfolio-cue-pulse 1.75s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  .portfolio-showcase-stage.is-guiding .portfolio-showcase-cue__dot {
    animation-duration: 0.95s;
  }

  @keyframes portfolio-ambient-float-left {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(2.5rem, 1.75rem, 0) scale(1.08);
    }
  }

  @keyframes portfolio-ambient-float-right {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-2rem, -1.5rem, 0) scale(1.1);
    }
  }

  @keyframes portfolio-grid-drift {
    from {
      background-position: 0 0, 0 0;
    }
    to {
      background-position: 0 4.25rem, 4.25rem 0;
    }
  }

  @keyframes portfolio-cue-pulse {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.95;
    }
    50% {
      transform: translateY(2.5rem);
      opacity: 0.35;
    }
  }

  @media (max-width: 767px) {
    .portfolio-showcase-stage {
      min-height: min(72vh, 34rem);
      padding: 0.875rem;
      border-radius: 1.5rem;
    }

    .portfolio-showcase-label {
      max-width: calc(100% - 0.5rem);
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      line-height: 1.4;
      padding: 0.6rem 0.8rem;
    }

    .portfolio-showcase-ambient {
      width: min(16rem, 72vw);
      height: min(16rem, 72vw);
      filter: blur(12px);
    }

    .portfolio-showcase-ambient--left {
      top: -12%;
      left: -16%;
    }

    .portfolio-showcase-ambient--right {
      right: -18%;
      bottom: -18%;
    }

    .portfolio-showcase-beam {
      width: min(calc(100% - 1rem), 24rem);
      height: min(56vh, 20rem);
      top: 16%;
    }

    .portfolio-showcase-cue {
      max-width: calc(100% - 1rem);
    }

    .portfolio-showcase-cue__track {
      height: 3.5rem;
    }
  }
</style>
