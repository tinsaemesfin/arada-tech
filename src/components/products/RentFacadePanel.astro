---
import RentFacade from './RentFacade.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const legend = [
  { label: 'Paid', swatch: 'bg-[#047857] border-[#047857]' },
  { label: 'Due', swatch: 'bg-white border-neutral-300' },
  { label: 'Overdue', swatch: 'bg-white border-[#b91c1c]' },
  { label: 'Vacant', swatch: 'rent-hatch border-neutral-300' },
];
---

<figure class:list={['relative mx-auto w-full max-w-4xl rounded-2xl border border-neutral-200 bg-neutral-50', className]}>
  <div class="flex aspect-[16/10] w-full flex-col justify-between p-4 sm:p-6">
    <div class="flex items-start justify-between font-mono text-[10px] uppercase tracking-[0.18em] text-neutral-500 sm:text-[11px]">
      <span>Fig. 01 · Lease map</span>
      <span>rent.aradatech.com</span>
    </div>

    <div class="flex flex-1 items-end justify-center pt-2">
      <RentFacade size="lg" />
    </div>

    <figcaption class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] text-neutral-600 sm:text-[11px]">
      {legend.map((item) => (
        <span class="inline-flex items-center gap-1.5">
          <span class:list={['inline-block h-2.5 w-2.5 border', item.swatch]} aria-hidden="true"></span>
          {item.label}
        </span>
      ))}
    </figcaption>
  </div>
</figure>

<style>
  .rent-hatch {
    background: repeating-linear-gradient(-45deg, transparent 0 2px, #dee2e6 2px 3px);
  }
</style>
