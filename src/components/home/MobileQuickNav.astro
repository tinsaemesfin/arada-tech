---
import { caseStudies } from '@data/portfolio';

const testimonials = caseStudies
  .filter((s) => s.testimonial)
  .map((s) => ({ ...s.testimonial!, company: s.client }));

const firstTestimonial = testimonials[0];

const navItems = [
  {
    title: 'Our Services',
    description: 'Web, mobile apps & custom software',
    href: '/services/',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    color: 'from-primary-500 to-primary-600',
    iconBg: 'bg-primary-50',
    iconColor: 'text-primary-500',
  },
  {
    title: 'Our Work',
    description: 'Projects that speak for themselves',
    href: '/portfolio/',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
    color: 'from-secondary-400 to-secondary-500',
    iconBg: 'bg-secondary-50',
    iconColor: 'text-secondary-500',
  },
  {
    title: 'Latest Insights',
    description: 'Tips & guides for Ethiopian businesses',
    href: '/blog/',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
    color: 'from-emerald-500 to-emerald-600',
    iconBg: 'bg-emerald-50',
    iconColor: 'text-emerald-600',
  },
];

const processSteps = [
  { number: '01', title: 'Discover' },
  { number: '02', title: 'Design' },
  { number: '03', title: 'Develop' },
  { number: '04', title: 'Deploy' },
];

const stats = [
  { value: '12+', label: 'Years' },
  { value: '50+', label: 'Projects' },
  { value: '98%', label: 'Satisfaction' },
];
---

<div class="md:hidden">
  <!-- Stats bar -->
  <div class="bg-gradient-to-r from-primary-500 via-primary-600 to-primary-800 py-5 px-4">
    <div class="flex justify-around items-center max-w-sm mx-auto">
      {stats.map((stat, i) => (
        <div class="text-center">
          <div class="text-xl font-display font-bold text-white">{stat.value}</div>
          <div class="text-[11px] text-white/70 uppercase tracking-wider mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Quick navigation cards -->
  <section class="py-8 px-4 bg-neutral-50">
    <div class="max-w-lg mx-auto">
      <p class="text-xs font-semibold text-secondary-400 uppercase tracking-wider mb-4 px-1">Explore</p>

      <div class="space-y-3">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="flex items-center gap-4 p-4 bg-white rounded-xl border border-neutral-200/80 shadow-sm active:scale-[0.98] transition-all duration-200"
          >
            <div class={`w-11 h-11 rounded-xl ${item.iconBg} flex items-center justify-center shrink-0`}>
              <svg class={`w-5 h-5 ${item.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-[15px] font-bold text-neutral-900">{item.title}</h3>
              <p class="text-xs text-neutral-500 mt-0.5">{item.description}</p>
            </div>
            <svg class="w-4 h-4 text-neutral-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process steps (compact horizontal) -->
  <section class="py-6 px-4 bg-white">
    <div class="max-w-lg mx-auto">
      <p class="text-xs font-semibold text-secondary-400 uppercase tracking-wider mb-4 px-1">How We Work</p>
      <div class="flex items-center gap-1">
        {processSteps.map((step, i) => (
          <div class="flex items-center flex-1">
            <div class="flex flex-col items-center flex-1">
              <div class="w-9 h-9 rounded-xl bg-primary-50 border border-primary-100 flex items-center justify-center mb-1.5">
                <span class="text-xs font-bold text-primary-500">{step.number}</span>
              </div>
              <span class="text-[11px] font-medium text-neutral-700">{step.title}</span>
            </div>
            {i < processSteps.length - 1 && (
              <svg class="w-3 h-3 text-neutral-300 shrink-0 -mt-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Testimonial highlight */}
  {firstTestimonial && (
    <section class="py-6 px-4 bg-neutral-50">
      <div class="max-w-lg mx-auto">
        <div class="bg-primary-500 rounded-2xl p-5 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-secondary-400/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <svg class="w-6 h-6 text-secondary-400 mb-3 relative" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
          </svg>
          <p class="text-sm text-white/90 leading-relaxed mb-3 line-clamp-3 relative">{firstTestimonial.quote}</p>
          <div class="relative">
            <div class="text-sm font-semibold">{firstTestimonial.author}</div>
            <div class="text-xs text-white/60">{firstTestimonial.role}</div>
          </div>
        </div>
      </div>
    </section>
  )}
</div>
