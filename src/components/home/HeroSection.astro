---
import { company } from '@data/company';

const barHeights = [40, 65, 45, 80, 55, 70, 90, 60, 75, 85, 50, 95];
---

<section id="hero" class="relative min-h-0 lg:min-h-[calc(100vh-var(--header-height))] overflow-hidden bg-white">
  <!-- Main content: on mobile, height follows content so the blue section below sits closer -->
  <div class="hero-content relative z-10 min-h-0 lg:min-h-[calc(100vh-var(--header-height))] flex flex-col justify-start pt-4 pb-4 sm:pb-5 sm:pt-5 lg:justify-center lg:pt-0 lg:pb-0 section-padding">
    <div class="section-container">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        <!-- Text column -->
        <div class="lg:col-span-6">
          <div class="hero-badge inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-primary-100 bg-primary-50/80 mb-5 sm:mb-6 lg:mb-8 opacity-100 lg:opacity-0">
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="hidden lg:block animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary-400 opacity-75" aria-hidden="true"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-secondary-400"></span>
            </span>
            <span class="text-sm font-medium text-primary-600">Software Development Company in Addis Ababa</span>
          </div>

          <h1 class="mb-6 lg:mb-8">
            <span class="hero-title-line block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-display font-bold text-neutral-900 leading-[1.08] mb-3 max-lg:[clip-path:inset(0_0_0_0)]">
              We Build Digital Products
            </span>
            <span class="hero-title-line block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-display font-bold leading-[1.08] max-lg:[clip-path:inset(0_0_0_0)]">
              <span class="text-gradient">That Drive Growth</span>
            </span>
          </h1>

          <p class="lg:hidden text-base text-neutral-900 leading-relaxed mb-8 max-w-xl">
            Custom websites, web apps, and mobile software for businesses in Ethiopia. Based in {company.address.city} since {company.foundedYear}.
          </p>
          <p class="hero-description hidden lg:block text-lg sm:text-xl text-neutral-900 leading-relaxed mb-10 max-w-xl opacity-100 lg:opacity-0">
            {company.name} is a software development company headquartered in {company.address.city}, {company.address.country}, founded in {company.foundedYear}. We design, build, and deploy custom websites, web apps, mobile apps, and software for businesses in Ethiopia and beyond.
          </p>

          <div class="hero-ctas flex flex-col sm:flex-row gap-4 mb-10 lg:mb-14 opacity-100 lg:opacity-0">
            <a href="/contact/" class="btn-secondary btn-lg magnetic-btn group">
              <span>Start Your Project</span>
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/portfolio/" class="btn-outline btn-lg magnetic-btn group">
              <span>View Our Work</span>
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <div class="hero-trust flex flex-wrap items-center gap-x-8 gap-y-3 opacity-100 lg:opacity-0">
            <div class="flex items-center gap-2 text-neutral-700 text-sm">
              <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
              <span>Since {company.foundedYear}</span>
            </div>
            <div class="flex items-center gap-2 text-neutral-700 text-sm">
              <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
              <span>30+ Projects Delivered</span>
            </div>
            <div class="flex items-center gap-2 text-neutral-700 text-sm">
              <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
              <span>Based in Addis Ababa</span>
            </div>
          </div>
        </div>

        <!-- Floating device mockups (desktop) -->
        <div class="hero-devices-lg hidden lg:block lg:col-span-6 relative">
          <div class="hero-devices relative [perspective:1200px]">

            <!-- Browser / Dashboard -->
            <div class="hero-device hero-browser opacity-0" style="transform: rotateY(-8deg) rotateX(5deg)">
              <div class="rounded-xl overflow-hidden border border-neutral-200/80 bg-white shadow-2xl shadow-neutral-900/[0.08]">
                <div class="flex items-center gap-2 px-4 py-3 border-b border-neutral-100 bg-neutral-50/80">
                  <div class="flex gap-1.5">
                    <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></div>
                  </div>
                  <div class="flex-1 mx-6">
                    <div class="h-5 rounded-md bg-neutral-100 max-w-[180px] mx-auto flex items-center justify-center">
                      <span class="text-[9px] text-neutral-400 font-mono">dashboard.aradatech.com</span>
                    </div>
                  </div>
                </div>
                <div class="p-4 space-y-3">
                  <div class="flex gap-3">
                    <div class="flex-1 h-16 rounded-lg bg-gradient-to-br from-primary-50 to-primary-100/50 border border-primary-100/60 p-3">
                      <div class="h-1.5 w-10 bg-primary-200 rounded mb-2"></div>
                      <div class="font-mono text-[11px] font-semibold text-primary-500">2.4k</div>
                    </div>
                    <div class="flex-1 h-16 rounded-lg bg-gradient-to-br from-secondary-50 to-secondary-100/50 border border-secondary-100/60 p-3">
                      <div class="h-1.5 w-10 bg-secondary-200 rounded mb-2"></div>
                      <div class="font-mono text-[11px] font-semibold text-secondary-500">89%</div>
                    </div>
                    <div class="flex-1 h-16 rounded-lg bg-gradient-to-br from-emerald-50 to-emerald-100/50 border border-emerald-100/60 p-3">
                      <div class="h-1.5 w-10 bg-emerald-200 rounded mb-2"></div>
                      <div class="font-mono text-[11px] font-semibold text-emerald-600">+12</div>
                    </div>
                  </div>
                  <div class="h-28 rounded-lg bg-neutral-50/80 border border-neutral-100 p-3">
                    <div class="flex items-end gap-[3px] h-full">
                      {barHeights.map((h, i) => (
                        <div
                          class="dash-bar flex-1 rounded-sm bg-gradient-to-t from-primary-500/50 to-primary-300/30"
                          style={`height: ${h}%; --bar-delay: ${i * 0.08}s`}
                        ></div>
                      ))}
                    </div>
                  </div>
                  <div class="flex gap-3">
                    <div class="flex-[2] h-14 rounded-lg bg-neutral-50/80 border border-neutral-100 p-2.5">
                      <div class="flex gap-2 mb-2">
                        <div class="h-1.5 w-12 bg-neutral-200 rounded"></div>
                        <div class="h-1.5 w-8 bg-neutral-100 rounded"></div>
                      </div>
                      <div class="h-1.5 w-full bg-neutral-100 rounded">
                        <div class="h-full w-3/4 bg-secondary-300/60 rounded"></div>
                      </div>
                    </div>
                    <div class="flex-1 h-14 rounded-lg bg-neutral-50/80 border border-neutral-100 p-2.5 flex items-center justify-center">
                      <div class="w-8 h-8 rounded-full border-2 border-primary-200 border-t-primary-500"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Phone -->
            <div class="hero-device hero-phone absolute -bottom-6 -left-6 z-10 opacity-0" style="transform: rotateY(5deg) rotateX(-3deg)">
              <div class="w-[140px] rounded-[20px] overflow-hidden border border-neutral-200/80 bg-white shadow-2xl shadow-neutral-900/[0.08]">
                <div class="flex justify-center py-2.5 bg-neutral-50/50">
                  <div class="w-14 h-[5px] rounded-full bg-neutral-200"></div>
                </div>
                <div class="px-2.5 pb-3 space-y-2">
                  <div class="h-7 rounded-lg bg-gradient-to-r from-primary-500 to-primary-400 flex items-center px-2">
                    <div class="h-1.5 w-12 bg-white/60 rounded"></div>
                  </div>
                  <div class="h-[52px] rounded-lg bg-neutral-50 border border-neutral-100 p-2">
                    <div class="h-1.5 w-10 bg-neutral-300 rounded mb-1.5"></div>
                    <div class="h-1.5 w-16 bg-neutral-200 rounded mb-1.5"></div>
                    <div class="h-1.5 w-8 bg-neutral-100 rounded"></div>
                  </div>
                  <div class="h-[52px] rounded-lg bg-neutral-50 border border-neutral-100 p-2">
                    <div class="flex gap-1.5 mb-1.5">
                      <div class="w-5 h-5 rounded-md bg-secondary-100"></div>
                      <div class="flex-1">
                        <div class="h-1.5 w-10 bg-neutral-300 rounded mb-1"></div>
                        <div class="h-1.5 w-14 bg-neutral-200 rounded"></div>
                      </div>
                    </div>
                    <div class="h-1.5 w-full bg-neutral-100 rounded">
                      <div class="h-full w-2/3 bg-emerald-300/50 rounded"></div>
                    </div>
                  </div>
                  <div class="flex gap-1 justify-center pt-1">
                    <div class="w-[18px] h-[18px] rounded-full bg-neutral-100 flex items-center justify-center">
                      <div class="w-2 h-2 rounded-sm bg-neutral-300"></div>
                    </div>
                    <div class="w-[18px] h-[18px] rounded-full bg-primary-50 flex items-center justify-center">
                      <div class="w-2 h-2 rounded-full bg-primary-400"></div>
                    </div>
                    <div class="w-[18px] h-[18px] rounded-full bg-neutral-100 flex items-center justify-center">
                      <div class="w-2 h-2 rounded-sm bg-neutral-300"></div>
                    </div>
                    <div class="w-[18px] h-[18px] rounded-full bg-neutral-100 flex items-center justify-center">
                      <div class="w-1.5 h-1.5 rounded-full bg-neutral-300"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Code Window (dark theme for contrast) -->
            <div class="hero-device hero-code absolute -top-6 -right-2 opacity-0" style="transform: rotateY(-12deg) rotateX(8deg)">
              <div class="w-[210px] rounded-xl overflow-hidden border border-neutral-700/20 bg-[#1e1e2e] shadow-2xl shadow-neutral-900/15">
                <div class="flex items-center gap-2 px-3 py-2 border-b border-white/[0.06] bg-[#181825]">
                  <div class="flex gap-1">
                    <div class="w-2 h-2 rounded-full bg-[#ff5f57]/70"></div>
                    <div class="w-2 h-2 rounded-full bg-[#febc2e]/70"></div>
                    <div class="w-2 h-2 rounded-full bg-[#28c840]/70"></div>
                  </div>
                  <span class="text-[10px] text-white/30 font-mono ml-1">index.tsx</span>
                </div>
                <div class="p-3 font-mono text-[10px] leading-[1.7]">
                  <div><span class="text-[#cba6f7]">const</span> <span class="text-[#89b4fa]">app</span> <span class="text-white/40">=</span> <span class="text-[#f9e2af]">createApp</span><span class="text-white/30">()</span></div>
                  <div class="text-white/25 pl-3">.configure<span class="text-white/15">({</span></div>
                  <div class="text-white/20 pl-6">port: <span class="text-[#a6e3a1]">3000</span>,</div>
                  <div class="text-white/20 pl-6">env: <span class="text-[#fab387]">'production'</span></div>
                  <div class="text-white/20 pl-3">})</div>
                  <div class="text-white/25 pl-3">.<span class="text-[#89b4fa]">listen</span><span class="text-white/15">()</span></div>
                  <div class="mt-1.5"><span class="text-[#cba6f7]">export</span> <span class="text-[#cba6f7]">default</span> <span class="text-[#89b4fa]">app</span></div>
                </div>
              </div>
            </div>

            <!-- Notification -->
            <div class="hero-device hero-notification absolute top-1/3 -left-14 opacity-0">
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl border border-neutral-200/80 bg-white shadow-lg shadow-neutral-900/[0.05]">
                <div class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                </div>
                <div>
                  <div class="text-[10px] font-medium text-neutral-700">Deployed</div>
                  <div class="text-[9px] text-neutral-400">Production build live</div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Scroll indicator (desktop only — no motion on small screens) -->
  <div class="hidden lg:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-3 z-10" aria-hidden="true">
    <span class="text-[10px] uppercase tracking-[0.25em] text-neutral-300 font-medium">Scroll</span>
    <div class="w-px h-12 relative overflow-hidden">
      <div class="absolute inset-0 bg-neutral-200"></div>
      <div class="absolute top-0 left-0 w-full h-1/3 bg-gradient-to-b from-secondary-400 to-transparent animate-scroll-line"></div>
    </div>
  </div>
</section>
