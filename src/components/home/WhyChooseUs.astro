---
const stats = [
  { value: '12+', label: 'Years of Experience' },
  { value: '50+', label: 'Projects Delivered' },
  { value: '98%', label: 'Client Satisfaction' },
  { value: '24/7', label: 'Support Available' },
];

const differentiators = [
  {
    title: 'Local Expertise, Global Standards',
    description: 'Based in Addis Ababa, we understand the Ethiopian market while building to international quality standards.',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'End-to-End Partnership',
    description: 'From strategy to deployment and beyond — we are your long-term technology partner, not a one-time vendor.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Performance-First Engineering',
    description: 'Every line of code is written for speed, security, and scalability. We don\'t cut corners on quality.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Transparent Communication',
    description: 'Regular updates, clear timelines, and honest conversations. You always know exactly where your project stands.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
];
---

<section class="section-gap">
  <div class="section-padding">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: Content -->
        <div>
          <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block reveal-up">Why Arada Tech</span>
          <h2 class="heading-lg mb-6 reveal-up">
            A Technology Partner You Can Trust
          </h2>
          <p class="prose-content mb-8 reveal-up">
            Since 2012, we have been helping businesses in Addis Ababa and across Ethiopia transform their operations through custom software solutions. We combine deep technical expertise with genuine understanding of local business challenges.
          </p>

          <div class="grid grid-cols-2 gap-6 stagger-children">
            {differentiators.map((item) => (
              <div class="flex flex-col gap-3">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                  </svg>
                </div>
                <h3 class="font-bold text-neutral-900">{item.title}</h3>
                <p class="text-sm text-neutral-600 leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Stats -->
        <div class="reveal-right">
          <div class="bg-gradient-to-br from-primary-500 via-primary-600 to-primary-800 rounded-3xl p-8 sm:p-12 text-white relative overflow-hidden">
            {/* Decorative elements */}
            <div class="absolute top-0 right-0 w-40 h-40 bg-secondary-400/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

            <div class="relative grid grid-cols-2 gap-8">
              {stats.map((stat) => (
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl font-display font-bold mb-2" data-count={stat.value}>{stat.value}</div>
                  <div class="text-sm text-white/70">{stat.label}</div>
                </div>
              ))}
            </div>

            <div class="relative mt-10 pt-8 border-t border-white/10">
              <p class="text-white/80 text-sm leading-relaxed text-center">
                Trusted by businesses across Ethiopia to deliver software that makes a real impact.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
