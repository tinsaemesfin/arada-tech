---
import { caseStudies } from '@data/portfolio';

const testimonials = caseStudies
  .filter((s) => s.testimonial)
  .map((s) => ({ ...s.testimonial!, company: s.client }));
---

<section class="section-gap bg-primary-500 text-white relative overflow-hidden">
  {/* Decorative */}
  <div class="absolute top-0 right-0 w-96 h-96 bg-secondary-400/10 rounded-full -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/3"></div>

  <div class="section-padding relative">
    <div class="section-container">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-up">
        <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">Client Testimonials</span>
        <h2 class="heading-lg text-white">What Our Clients Say</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger-children">
        {testimonials.map((t) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/10">
            <svg class="w-8 h-8 text-secondary-400 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
            </svg>
            <p class="text-white/90 leading-relaxed mb-6">{t.quote}</p>
            <div>
              <div class="font-semibold text-white">{t.author}</div>
              <div class="text-sm text-white/60">{t.role}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
