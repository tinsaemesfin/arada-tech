---
const categoryColors: Record<string, { bg: string; text: string; dot: string }> = {
  Technology: { bg: 'bg-blue-50', text: 'text-blue-600', dot: 'bg-blue-500' },
  Business: { bg: 'bg-emerald-50', text: 'text-emerald-600', dot: 'bg-emerald-500' },
  Design: { bg: 'bg-purple-50', text: 'text-purple-600', dot: 'bg-purple-500' },
};

const posts: {
  title: string;
  excerpt: string;
  href: string;
  category: string;
  date: string;
  readTime: string;
  image?: string;
}[] = [
  {
    title: "Don't Start With the App. Start With the Workflow.",
    excerpt: 'Most teams jump straight to screens, then wonder why nobody uses what they built. Map how work actually happens first. Then build.',
    href: '/blog/start-with-the-workflow/',
    category: 'Business',
    date: 'September 14, 2026',
    readTime: '4 min read',
    image: '/images/blog/start-with-the-workflow.png',
  },
  {
    title: 'How Much Does a Custom Website Cost in Ethiopia?',
    excerpt: 'A comprehensive guide to website development pricing in Ethiopia, covering factors that influence cost and what to expect.',
    href: '/blog/custom-website-cost-ethiopia-2026/',
    category: 'Business',
    date: 'March 15, 2026',
    readTime: '7 min read',
  },
  {
    title: 'Why Addis Ababa Businesses Need Custom Web Applications',
    excerpt: 'Discover how custom web applications are helping businesses in Addis Ababa streamline operations and gain competitive advantages.',
    href: '/blog/why-addis-ababa-businesses-need-web-applications/',
    category: 'Technology',
    date: 'March 8, 2026',
    readTime: '6 min read',
  },
];
---

<section class="section-gap">
  <div class="section-padding">
    <div class="section-container">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-6">
        <div class="reveal-up">
          <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">Insights</span>
          <h2 class="heading-lg">Latest from Our Blog</h2>
          <p class="text-neutral-600 mt-3 max-w-xl">Stay up to date with practical insights on software development and technology for Ethiopian businesses.</p>
        </div>
        <a href="/blog/" class="btn-outline shrink-0 reveal-up">
          All Articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger-children">
        {posts.map((post) => {
          const catColor = categoryColors[post.category] || { bg: 'bg-primary-50', text: 'text-primary-600', dot: 'bg-primary-500' };
          return (
            <a href={post.href} class="group block">
              <div class="bg-white rounded-2xl border border-neutral-200/60 overflow-hidden h-full hover:shadow-xl hover:shadow-neutral-900/5 hover:-translate-y-1 transition-all duration-300">
                <div class="relative aspect-[16/10] bg-gradient-to-br from-primary-100 via-primary-50 to-secondary-50 overflow-hidden">
                  {post.image ? (
                    <img
                      src={post.image}
                      alt={post.title}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <>
                      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-primary-200/40 via-transparent to-secondary-200/40"></div>
                      <div class="absolute inset-0 flex items-center justify-center">
                        <div class="w-14 h-14 rounded-xl bg-white/50 backdrop-blur-sm flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
                          <svg class="w-7 h-7 text-primary-300" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                          </svg>
                        </div>
                      </div>
                    </>
                  )}
                  <div class="absolute top-3 right-3 px-2.5 py-1 bg-white/80 backdrop-blur-sm rounded-full text-xs font-medium text-neutral-600">
                    {post.readTime}
                  </div>
                </div>

                <div class="p-5">
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 ${catColor.bg} ${catColor.text} text-xs font-semibold rounded-full`}>
                      <span class={`w-1 h-1 rounded-full ${catColor.dot}`}></span>
                      {post.category}
                    </span>
                    <span class="text-neutral-300">&middot;</span>
                    <span class="text-xs text-neutral-400">{post.date}</span>
                  </div>
                  <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary-500 transition-colors mb-2 leading-snug">{post.title}</h3>
                  <p class="text-sm text-neutral-500 line-clamp-2">{post.excerpt}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
