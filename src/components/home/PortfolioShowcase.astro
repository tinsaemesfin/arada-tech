---
import { caseStudies } from '@data/portfolio';
import PortfolioLaptopMockup from '@components/portfolio/PortfolioLaptopMockup.astro';

const featuredStudies = caseStudies
  .filter((c) => c.featuredRank != null)
  .sort((a, b) => (a.featuredRank ?? 0) - (b.featuredRank ?? 0));

const moreProjectCount = caseStudies.length - featuredStudies.length;
---

<section class="section-gap">
  <div class="section-padding">
    <div class="section-container">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-6">
        <div class="reveal-up">
          <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">Our Work</span>
          <h2 class="heading-lg">Projects That Speak for Themselves</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {featuredStudies.map((study, index) => (
          <a href={`/portfolio/${study.slug}/`} class="group block tilt-card">
            <div class="relative mb-6">
              {study.coverImage && (
                <PortfolioLaptopMockup
                  src={study.coverImage}
                  alt={`${study.title} — product preview`}
                  priority={index === 0}
                  class="w-full group-hover:ring-2 group-hover:ring-primary-500/20 transition-shadow duration-300 rounded-t-[1.25rem]"
                />
              )}
              <div
                class="pointer-events-none absolute inset-0 z-10 rounded-t-[1.25rem] bg-neutral-900/0 transition-colors duration-300 group-hover:bg-neutral-900/10"
                aria-hidden="true"
              />
            </div>
            <div>
              <div class="flex flex-wrap gap-2 mb-3">
                {study.services.map((service) => (
                  <span class="text-xs font-medium text-primary-500 bg-primary-50 px-2.5 py-1 rounded-full">{service}</span>
                ))}
              </div>
              <h3 class="text-lg font-bold text-neutral-900 group-hover:text-primary-500 transition-colors mb-2">{study.title}</h3>
              <p class="text-sm text-neutral-600 line-clamp-2">{study.challenge.slice(0, 120)}...</p>
            </div>
          </a>
        ))}
      </div>

      {moreProjectCount > 0 && (
        <div class="mt-12 flex justify-center reveal-up">
          <a href="/portfolio/" class="btn-outline inline-flex items-center gap-2">
            More projects
            <span class="text-neutral-500 font-normal">({moreProjectCount} more)</span>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
