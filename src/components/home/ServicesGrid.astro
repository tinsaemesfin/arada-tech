---
import { services } from '@data/services';

const iconPaths: Record<string, string> = {
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
};
---

<section class="section-gap bg-neutral-50" id="services">
  <div class="section-padding">
    <div class="section-container">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-up">
        <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block">What We Do</span>
        <h2 class="heading-lg mb-4">Solutions That Move Your Business Forward</h2>
        <p class="prose-content">From concept to deployment, we provide end to end digital solutions tailored to the unique needs of businesses in Ethiopia and across Africa.</p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {services.map((service, index) => (
          <a
            href={service.href}
            class="card-hover tilt-card group relative overflow-hidden"
            style={`--delay: ${index * 0.1}s`}
          >
            {/* Accent bar */}
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary-500 to-secondary-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center shrink-0 group-hover:bg-primary-500 transition-colors duration-300">
                <svg class="w-6 h-6 text-primary-500 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[service.icon]} />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-primary-500 transition-colors">{service.title}</h3>
                <p class="text-sm text-neutral-600 leading-relaxed mb-4">{service.tagline}</p>
                <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-500 group-hover:gap-2 transition-all">
                  Learn more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10 reveal-up">
        <a href="/services/" class="btn-outline">View All Services</a>
      </div>
    </div>
  </div>
</section>
