---
import { company } from '@data/company';
import { caseStudies } from '@data/portfolio';
import { services } from '@data/services';

const iconPaths: Record<string, string> = {
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
};

const featuredStudies = caseStudies
  .filter((study) => study.featuredRank != null)
  .sort((a, b) => (a.featuredRank ?? 0) - (b.featuredRank ?? 0));

const servicePriority = [
  'custom-software-development',
  'mobile-app-development',
  'web-application-development',
  'ui-ux-design',
  'website-development',
];

const featuredServices = [...services].sort(
  (a, b) => servicePriority.indexOf(a.slug) - servicePriority.indexOf(b.slug)
);

const serviceCopy: Record<string, { title: string; tagline: string }> = {
  'custom-software-development': {
    title: 'Custom Software',
    tagline: 'Operational systems built around your workflows, approvals, data, and reporting needs.',
  },
  'mobile-app-development': {
    title: 'Mobile Apps',
    tagline: 'iOS and Android products with polished flows, backend APIs, and launch support.',
  },
  'web-application-development': {
    title: 'Web Platforms',
    tagline: 'Dashboards, portals, SaaS products, and business tools that run in the browser.',
  },
  'ui-ux-design': {
    title: 'Product Design',
    tagline: 'Research, interface design, and prototypes for complex products users can understand fast.',
  },
  'website-development': {
    title: 'Web Presence',
    tagline: 'Performance-focused company sites and web platforms that support serious sales conversations.',
  },
};

const processSteps = [
  {
    label: '01',
    title: 'Map the operation',
    body: 'We study your workflow, users, data, and revenue goals before choosing the right product shape.',
  },
  {
    label: '02',
    title: 'Design the product',
    body: 'We turn complex business logic into clear mobile and web experiences your team can trust.',
  },
  {
    label: '03',
    title: 'Build the system',
    body: 'We develop the app, platform, integrations, automations, and APIs with production discipline.',
  },
  {
    label: '04',
    title: 'Launch with support',
    body: 'We deploy, monitor, improve, and keep the product aligned with the way your business grows.',
  },
];

const stats = [
  { value: '10+', label: 'Years building' },
  { value: '30+', label: 'Projects shipped' },
  { value: '98%', label: 'Client satisfaction' },
];

const launchParticles = [
  { x: '-94px', y: '-76px', r: '-28deg', d: '0s' },
  { x: '-68px', y: '-126px', r: '42deg', d: '0.04s' },
  { x: '-28px', y: '-96px', r: '-62deg', d: '0.08s' },
  { x: '16px', y: '-132px', r: '26deg', d: '0.02s' },
  { x: '58px', y: '-92px', r: '78deg', d: '0.1s' },
  { x: '92px', y: '-118px', r: '-34deg', d: '0.06s' },
  { x: '-104px', y: '-24px', r: '64deg', d: '0.12s' },
  { x: '108px', y: '-34px', r: '-72deg', d: '0.14s' },
  { x: '-44px', y: '-154px', r: '18deg', d: '0.16s' },
  { x: '44px', y: '-160px', r: '-18deg', d: '0.18s' },
  { x: '-8px', y: '-186px', r: '0deg', d: '0.2s' },
  { x: '0px', y: '-108px', r: '90deg', d: '0.05s' },
];
---

<div id="mobile-experience" class="md:hidden mobile-app-experience relative overflow-hidden bg-[#071124] text-white">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="mobile-orb mobile-orb-primary"></div>
    <div class="mobile-orb mobile-orb-secondary"></div>
  </div>

  <section class="relative px-4 pt-6 pb-8">
    <div class="mx-auto max-w-lg">
      <div class="mobile-reveal rounded-[2rem] border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-black/20 backdrop-blur-xl">
        <div class="grid grid-cols-3 gap-2">
          {stats.map((stat) => (
            <div class="rounded-2xl bg-white/[0.08] px-3 py-4 text-center ring-1 ring-white/10">
              <div class="font-display text-2xl font-bold text-white">{stat.value}</div>
              <div class="mt-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/50">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative px-4 py-10">
    <div class="mx-auto max-w-lg">
      <div class="mobile-reveal mb-7">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-secondary-300">Choose your system</p>
        <h2 class="font-display text-3xl font-bold leading-tight text-white">
          Build the software layer your business has been missing.
        </h2>
        <p class="mt-4 text-sm leading-6 text-white/68">
          We focus on custom software, mobile apps, dashboards, and integrated platforms that solve operational problems, not just pages that look good.
        </p>
      </div>

      <div class="mobile-service-grid grid grid-cols-2 gap-3">
        {featuredServices.map((service, index) => (
          <a
            href={service.href}
            class:list={[
              'mobile-service-card mobile-reveal group relative min-h-[154px] overflow-hidden rounded-[1.6rem] border border-white/10 bg-white/[0.07] p-4 shadow-xl shadow-black/10 backdrop-blur-xl active:scale-[0.98]',
              index === 0 ? 'col-span-2 min-h-[132px] bg-gradient-to-br from-secondary-400 to-secondary-500 text-white' : '',
            ]}
          >
            <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-white/10 blur-2xl"></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex items-start justify-between gap-3">
                <div class:list={[
                  'flex h-11 w-11 items-center justify-center rounded-2xl ring-1',
                  index === 0 ? 'bg-white/18 text-white ring-white/20' : 'bg-white/10 text-secondary-300 ring-white/10',
                ]}>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[service.icon]} />
                  </svg>
                </div>
                <span class="rounded-full bg-white/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-white/65">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <div>
                <h3 class="text-base font-bold leading-tight text-white">{serviceCopy[service.slug]?.title ?? service.shortTitle}</h3>
                <p class:list={[
                  'mt-2 text-xs leading-5',
                  index === 0 ? 'text-white/82' : 'text-white/62',
                ]}>
                  {serviceCopy[service.slug]?.tagline ?? service.tagline}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <a href="/contact/" class="mobile-reveal mt-4 block rounded-[1.6rem] border border-primary-300/30 bg-primary-400/18 p-4 backdrop-blur-xl active:scale-[0.99]">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-secondary-400 text-white shadow-lg shadow-secondary-500/25">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-bold text-white">Need a serious system but not sure where to start?</h3>
            <p class="mt-1 text-xs leading-5 text-white/62">Tell us the workflow. We will recommend the right product architecture and launch path.</p>
          </div>
          <svg class="h-5 w-5 shrink-0 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    </div>
  </section>

  <section class="relative px-4 py-10">
    <div class="mx-auto max-w-lg">
      <div class="mobile-reveal mb-7">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-secondary-300">Built for real operations</p>
        <h2 class="font-display text-3xl font-bold leading-tight text-white">Platforms, apps, and business systems with measurable outcomes.</h2>
      </div>

      <div class="mobile-proof-stack space-y-4">
        {featuredStudies.map((study, index) => (
          <a
            href={`/portfolio/${study.slug}/`}
            class="mobile-proof-card mobile-reveal group block overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.08] shadow-2xl shadow-black/20 backdrop-blur-xl"
          >
            {study.coverImage && (
              <div class="relative aspect-[16/10] overflow-hidden bg-white/5">
                <img
                  src={study.coverImage}
                  alt={`${study.title} product preview`}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#071124] via-transparent to-transparent"></div>
              </div>
            )}
            <div class="-mt-10 p-5 pt-0 relative">
              <div class="mb-3 flex flex-wrap gap-2">
                {study.services.slice(0, 2).map((service) => (
                  <span class="rounded-full bg-white/12 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white/72">{service}</span>
                ))}
              </div>
              <h3 class="text-xl font-bold text-white">{study.title}</h3>
              <div class="mt-4 grid grid-cols-2 gap-2">
                {study.results.slice(0, 2).map((result) => (
                  <div class="rounded-2xl bg-white/[0.08] p-3 ring-1 ring-white/10">
                    <div class="text-lg font-bold text-secondary-300">{result.value}</div>
                    <div class="mt-1 text-[11px] leading-4 text-white/58">{result.metric}</div>
                  </div>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative px-4 py-10">
    <div class="mx-auto max-w-lg">
      <div class="mobile-reveal mb-7">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-secondary-300">From operation to product</p>
        <h2 class="font-display text-3xl font-bold leading-tight text-white">A clear path from business need to production software.</h2>
      </div>

      <div class="mobile-timeline relative space-y-4 pl-5">
        <div class="mobile-timeline-rail absolute left-[0.45rem] top-2 h-[calc(100%-1rem)] w-px overflow-hidden bg-white/12">
          <div class="mobile-timeline-fill h-full w-full origin-top bg-gradient-to-b from-secondary-300 to-primary-300"></div>
        </div>
        {processSteps.map((step) => (
          <div class:list={[
            'mobile-timeline-step mobile-reveal relative rounded-[1.6rem] border border-white/10 bg-white/[0.07] p-4 backdrop-blur-xl',
            step.label === '04' ? 'mobile-launch-step overflow-hidden' : '',
          ]}>
            <div class="absolute -left-[1.7rem] top-5 h-4 w-4 rounded-full border-2 border-[#071124] bg-secondary-300 shadow-lg shadow-secondary-400/30"></div>
            {step.label === '04' && (
              <div class="mobile-launch-burst pointer-events-none absolute inset-0" aria-hidden="true">
                <span class="mobile-launch-halo"></span>
                {launchParticles.map((_, index) => (
                  <span
                    data-launch-i={index}
                    class:list={[
                      'mobile-launch-particle',
                      index % 3 === 0 ? 'is-ring' : index % 3 === 1 ? 'is-shard' : 'is-diamond',
                    ]}
                  ></span>
                ))}
              </div>
            )}
            <div class="mb-3 inline-flex rounded-full bg-white/10 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white/60">{step.label}</div>
            <h3 class="text-lg font-bold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-white/62">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative px-4 py-10 pb-28">
    <div class="mx-auto max-w-lg">
      <div class="mobile-founder-card mobile-reveal overflow-hidden rounded-[2rem] border border-white/12 bg-gradient-to-br from-white/[0.14] to-white/[0.06] p-5 shadow-2xl shadow-black/25 backdrop-blur-xl">
        <div class="flex items-center gap-4">
          <div class="relative shrink-0">
            <div class="absolute inset-0 rounded-full bg-secondary-300 blur-xl opacity-40"></div>
            <img
              src="/images/tinsae-avatar.webp"
              alt={`${company.ceo}, founder of ${company.name}`}
              width="88"
              height="88"
              class="relative h-20 w-20 rounded-full border-2 border-white/25 object-cover shadow-xl"
              loading="lazy"
            />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-secondary-300">Founder note</p>
            <h2 class="mt-2 font-display text-2xl font-bold leading-tight text-white">Let us turn your workflow into software your team can rely on.</h2>
          </div>
        </div>
        <p class="mt-5 text-sm leading-6 text-white/68">
          I am {company.ceo}. If you are planning a mobile app, custom platform, or internal business system, start with a consultation and we will map the most practical way to build it.
        </p>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <a href="/contact/" class="rounded-2xl bg-secondary-400 px-4 py-3 text-center text-sm font-bold text-white shadow-lg shadow-secondary-500/25 active:scale-[0.98]">
            Start project
          </a>
          <a href={`tel:${company.phoneRaw}`} class="rounded-2xl border border-white/15 bg-white/[0.08] px-4 py-3 text-center text-sm font-bold text-white active:scale-[0.98]">
            Call now
          </a>
        </div>
      </div>
    </div>
  </section>

  <div id="mobile-sticky-cta" class="fixed inset-x-0 bottom-0 z-40 px-4 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pt-3 transition-all duration-300">
    <div class="mx-auto flex max-w-lg items-center gap-3 rounded-[1.35rem] border border-white/14 bg-[#071124]/88 p-2 shadow-2xl shadow-black/30 backdrop-blur-xl">
      <a href="/contact/" class="flex flex-1 items-center justify-center rounded-2xl bg-secondary-400 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-secondary-500/20">
        Start Your Project
      </a>
      <a href={`tel:${company.phoneRaw}`} class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-white" aria-label={`Call ${company.name}`}>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h2.2a1 1 0 01.95.68l1.1 3.3a1 1 0 01-.45 1.18l-1.4.82a12.2 12.2 0 005.62 5.62l.82-1.4a1 1 0 011.18-.45l3.3 1.1a1 1 0 01.68.95V19a2 2 0 01-2 2h-.5C9.49 21 3 14.51 3 6.5V5z" />
        </svg>
      </a>
    </div>
  </div>
</div>
