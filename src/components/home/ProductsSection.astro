---
import RentFacade from '@components/products/RentFacade.astro';
import { products } from '@data/products';

const host = (url: string) => new URL(url).host;
---

<section class="border-y border-neutral-200 bg-neutral-50" id="products" aria-labelledby="products-heading">
  <div class="section-padding py-10 md:py-14">
    <div class="section-container grid gap-6 md:grid-cols-[13rem_1fr] md:gap-10 md:items-center">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-neutral-500 mb-2">
          Products <span class="text-neutral-400">/ {String(products.length).padStart(2, '0')}</span>
        </p>
        <h2 id="products-heading" class="font-display text-xl font-bold leading-snug text-neutral-900">
          Software we build and run ourselves.
        </h2>
      </div>

      <ul class="flex flex-col gap-3">
        {products.map((product, i) => (
          <li>
            <a
              href={product.url}
              class="rent-collect group grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-4 rounded-xl border border-neutral-200 bg-white p-4 pr-5 transition-colors hover:border-neutral-900 focus-visible:border-neutral-900 sm:gap-x-7 md:grid-cols-[auto_1fr_auto]"
            >
              <RentFacade class="self-center" />

              <div class="min-w-0 self-center">
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-500">
                  {String(i + 1).padStart(2, '0')} · {product.category}
                </p>
                <h3 class="mt-1 font-display text-2xl font-bold tracking-tight text-neutral-900">{product.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-neutral-600 max-w-xl">{product.tagline}</p>
              </div>

              <div class="col-span-2 flex items-center justify-between gap-6 border-t border-dashed border-neutral-200 pt-3 md:flex-col md:items-end md:col-span-1 md:border-t-0 md:border-l md:pl-7 md:pt-0">
                <p class="font-mono text-[11px] leading-5 text-neutral-500 md:text-right">
                  <span class="block group-hover:hidden">2 units overdue</span>
                  <span class="hidden text-[#047857] group-hover:block">Collected. No chasing.</span>
                </p>
                <span class="inline-flex items-center gap-2 font-mono text-xs font-medium text-neutral-900">
                  {host(product.url)}
                  <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M9 7h8v8" /></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
