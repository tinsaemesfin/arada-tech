---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import CTA from '@components/global/CTA.astro';
import { caseStudies } from '@data/portfolio';

const study = caseStudies.find((s) => s.slug === 'arada-clear')!;
const breadcrumbs = [
  { name: 'Portfolio', href: '/portfolio/' },
  { name: study.title, href: `/portfolio/${study.slug}/` },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: study.title,
  description: study.challenge,
  url: new URL(`/portfolio/${study.slug}/`, Astro.site).href,
  creator: { '@type': 'Organization', name: 'Arada Tech', url: 'https://www.aradatech.com' },
};
---

<BaseLayout title={study.metaTitle} description={study.metaDescription} structuredData={structuredData} breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />

  <article class="section-padding pb-0">
    <div class="section-container max-w-4xl">
      <span class="text-sm font-medium text-secondary-400 uppercase tracking-wider mb-3 block reveal-up">{study.industry}</span>
      <h1 class="heading-xl mb-4 reveal-up">{study.title}</h1>
      <div class="flex flex-wrap gap-2 mb-8 reveal-up">
        {study.services.map((s) => (
          <span class="text-sm font-medium text-primary-600 bg-primary-50 px-3 py-1.5 rounded-full">{s}</span>
        ))}
      </div>
    </div>
  </article>

  <section class="section-padding">
    <div class="section-container">
      <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-neutral-100 reveal-scale">
        <div class="w-full h-full bg-gradient-to-br from-secondary-400/80 to-primary-700/90 flex items-center justify-center">
          <span class="text-white font-display font-bold text-3xl">{study.client}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap">
    <div class="section-padding">
      <div class="section-container max-w-4xl">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="reveal-left">
            <h2 class="heading-md mb-4">The Challenge</h2>
            <p class="prose-content">{study.challenge}</p>
          </div>
          <div class="reveal-right">
            <h2 class="heading-md mb-4">Our Solution</h2>
            <p class="prose-content">{study.solution}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap bg-neutral-50">
    <div class="section-padding">
      <div class="section-container">
        <h2 class="heading-lg text-center mb-12 reveal-up">Measurable Results</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
          {study.results.map((result) => (
            <div class="card text-center">
              <div class="text-3xl font-display font-bold text-primary-500 mb-2">{result.value}</div>
              <div class="font-semibold text-neutral-900 mb-1">{result.metric}</div>
              <div class="text-sm text-neutral-500">{result.description}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap">
    <div class="section-padding">
      <div class="section-container text-center">
        <h2 class="heading-md mb-6 reveal-up">Technologies Used</h2>
        <div class="flex flex-wrap justify-center gap-3 stagger-children">
          {study.technologies.map((tech) => (
            <span class="px-4 py-2 bg-neutral-50 border border-neutral-200 rounded-full text-sm font-medium text-neutral-700">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA variant="gradient" title="Building FinTech or Clearing?" description="Tell us about invoice volume, rules, and integrations — we can help design the right platform." />
</BaseLayout>

<script>
  import { initScrollAnimations } from '@scripts/scroll-animations';
  initScrollAnimations();
</script>
