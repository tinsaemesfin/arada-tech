---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import CTA from '@components/global/CTA.astro';
import { services } from '@data/services';

const breadcrumbs = [{ name: 'Services', href: '/services/' }];

const iconPaths: Record<string, string> = {
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  smartphone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Software Development Services',
  description: 'Explore Arada Tech\'s full range of software development services including website development, web apps, mobile apps, custom software, and UI/UX design.',
  url: new URL('/services/', Astro.site).href,
};
---

<BaseLayout
  title="Software Services | Addis Ababa"
  description="Services: websites, web apps, mobile apps, custom software, and UI/UX design in Addis Ababa, Ethiopia. End-to-end delivery from Arada Tech."
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section-padding pb-0">
    <div class="section-container max-w-4xl mx-auto text-center">
      <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block reveal-up">Our Services</span>
      <h1 class="heading-xl mb-6 reveal-up">End-to-End Digital Solutions for Your Business</h1>
      <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed max-w-3xl mx-auto reveal-up">
        From design to deployment, we provide comprehensive software development services tailored to the unique needs of businesses in Addis Ababa and across Ethiopia.
      </p>
      <p class="text-base sm:text-lg text-neutral-600 leading-relaxed max-w-3xl mx-auto mt-6 reveal-up">
        Typical engagements combine discovery workshops, UX and UI design, iterative engineering, QA, deployment, and handover documentation. We work with procurement-friendly milestones, integrate with SMS, payments, ERPs, and bespoke APIs, and design for performance on real-world networks and devices used in East Africa.
      </p>
    </div>
  </section>

  <section class="section-gap">
    <div class="section-padding">
      <div class="section-container">
        <div class="space-y-8 stagger-children">
          {services.map((service, index) => (
            <a href={service.href} class="card-hover block group">
              <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start">
                <div class="w-14 h-14 rounded-xl bg-primary-50 flex items-center justify-center shrink-0 group-hover:bg-primary-500 transition-colors duration-300">
                  <svg class="w-7 h-7 text-primary-500 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[service.icon]} />
                  </svg>
                </div>
                <div class="flex-1">
                  <h2 class="text-xl font-bold text-neutral-900 mb-2 group-hover:text-primary-500 transition-colors">{service.title}</h2>
                  <p class="text-neutral-600 leading-relaxed mb-4">{service.description}</p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {service.features.slice(0, 4).map((feature) => (
                      <span class="text-xs font-medium text-primary-600 bg-primary-50 px-3 py-1 rounded-full">{feature}</span>
                    ))}
                  </div>
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary-500 group-hover:gap-2 transition-all">
                    Learn more about {service.shortTitle}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA variant="gradient" />
</BaseLayout>

<script>
  import { initScrollAnimations } from '@scripts/scroll-animations';
  initScrollAnimations();
</script>
