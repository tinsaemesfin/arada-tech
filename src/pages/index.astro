---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import ServicesGrid from '@components/home/ServicesGrid.astro';
import WhyChooseUs from '@components/home/WhyChooseUs.astro';
import ProcessSection from '@components/home/ProcessSection.astro';
import PortfolioShowcase from '@components/home/PortfolioShowcase.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import BlogPreview from '@components/home/BlogPreview.astro';
import CTA from '@components/global/CTA.astro';
import MobileQuickNav from '@components/home/MobileQuickNav.astro';
import { brandAssets, company } from '@data/company';
import { services } from '@data/services';

const orgId = `${company.url}/#organization`;

const primaryNavItems = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
  { name: 'Services', path: '/services/' },
  ...services.map((s) => ({ name: s.title, path: s.href })),
  { name: 'Portfolio', path: '/portfolio/' },
  { name: 'Blog', path: '/blog/' },
  { name: 'Contact', path: '/contact/' },
  { name: 'FAQ', path: '/faq/' },
];

const navigationItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Primary site navigation',
  itemListElement: primaryNavItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SiteNavigationElement',
      name: item.name,
      url: new URL(item.path, Astro.site).href,
    },
  })),
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: company.name,
    url: company.url,
    description: company.description,
    publisher: { '@id': orgId },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${company.url}/blog/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  navigationItemList,
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${company.url}/#ceo`,
    name: company.ceo,
    jobTitle: 'Chief Executive Officer',
    worksFor: { '@id': orgId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    legalName: company.legalName,
    url: company.url,
    logo: `${company.url}${brandAssets.fullLogo}`,
    description: company.description,
    foundingDate: String(company.foundedYear),
    founder: {
      '@type': 'Person',
      name: company.ceo,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      addressLocality: company.address.city,
      addressCountry: company.address.countryCode,
      postalCode: company.address.postalCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: company.geo.latitude,
      longitude: company.geo.longitude,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: company.phone,
      contactType: 'customer service',
      email: company.email,
      availableLanguage: ['English', 'Amharic'],
    },
    sameAs: Object.values(company.social).filter(Boolean),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Software Development Services',
      itemListElement: services.map((s) => {
        const serviceUrl = new URL(s.href, Astro.site).href;
        return {
          '@type': 'Offer',
          url: serviceUrl,
          itemOffered: {
            '@type': 'Service',
            name: s.title,
            description: s.tagline,
            url: serviceUrl,
          },
        };
      }),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${company.url}/#local-business`,
    name: company.name,
    description: company.description,
    url: company.url,
    telephone: company.phone,
    email: company.email,
    image: `${company.url}${brandAssets.fullLogo}`,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      addressLocality: company.address.city,
      addressCountry: company.address.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: company.geo.latitude,
      longitude: company.geo.longitude,
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '19:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Saturday'],
        opens: '10:00',
        closes: '14:00',
      },
    ],
    areaServed: [
      { '@type': 'City', name: 'Addis Ababa' },
      { '@type': 'Country', name: 'Ethiopia' },
    ],
  },
];
---

<BaseLayout
  title="Arada Tech"
  description="Custom websites, web apps, mobile apps, and business software in Addis Ababa, Ethiopia. Arada Tech — software development since 2016. Book a free consultation."
  structuredData={structuredData}
>
  <HeroSection />

  {/* Mobile: compact quick-nav replaces heavy sections */}
  <MobileQuickNav />

  {/* Desktop: full sections (hidden on mobile) */}
  <div class="hidden md:block">
    <ServicesGrid />
    <WhyChooseUs />
    <ProcessSection />
    <PortfolioShowcase />
    <TestimonialsSection />
    <BlogPreview />
  </div>

  <CTA variant="gradient" />
</BaseLayout>

<script>
  import { initScrollAnimations, initCountUp, initHeroAnimations, initMagneticButtons, initTiltCards } from '@scripts/scroll-animations';
  import { initSmoothScroll } from '@scripts/smooth-scroll';

  initSmoothScroll();
  initHeroAnimations();
  initScrollAnimations();
  initCountUp();
  initMagneticButtons();
  initTiltCards();
</script>
