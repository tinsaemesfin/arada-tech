---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import ServicesGrid from '@components/home/ServicesGrid.astro';
import WhyChooseUs from '@components/home/WhyChooseUs.astro';
import ProcessSection from '@components/home/ProcessSection.astro';
import PortfolioShowcase from '@components/home/PortfolioShowcase.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import BlogPreview from '@components/home/BlogPreview.astro';
import CTA from '@components/global/CTA.astro';
import MobileExperience from '@components/home/MobileExperience.astro';
import { brandAssets, company } from '@data/company';
import { services } from '@data/services';

const orgId = `${company.url}/#organization`;

const primaryNavItems = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
  { name: 'Services', path: '/services/' },
  ...services.map((s) => ({ name: s.title, path: s.href })),
  { name: 'Portfolio', path: '/portfolio/' },
  { name: 'Blog', path: '/blog/' },
  { name: 'Contact', path: '/contact/' },
  { name: 'FAQ', path: '/faq/' },
];

const navigationItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Primary site navigation',
  itemListElement: primaryNavItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SiteNavigationElement',
      name: item.name,
      url: new URL(item.path, Astro.site).href,
    },
  })),
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: company.name,
    url: company.url,
    description: company.description,
    publisher: { '@id': orgId },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${company.url}/blog/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  navigationItemList,
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${company.url}/#ceo`,
    name: company.ceo,
    jobTitle: 'Chief Executive Officer',
    worksFor: { '@id': orgId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    legalName: company.legalName,
    url: company.url,
    logo: `${company.url}${brandAssets.fullLogo}`,
    description: company.description,
    foundingDate: String(company.foundedYear),
    founder: {
      '@type': 'Person',
      name: company.ceo,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      addressLocality: company.address.city,
      addressCountry: company.address.countryCode,
      postalCode: company.address.postalCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: company.geo.latitude,
      longitude: company.geo.longitude,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: company.phone,
      contactType: 'customer service',
      email: company.email,
      availableLanguage: ['English', 'Amharic'],
    },
    sameAs: Object.values(company.social).filter(Boolean),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Software Development Services',
      itemListElement: services.map((s) => {
        const serviceUrl = new URL(s.href, Astro.site).href;
        return {
          '@type': 'Offer',
          url: serviceUrl,
          itemOffered: {
            '@type': 'Service',
            name: s.title,
            description: s.tagline,
            url: serviceUrl,
          },
        };
      }),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${company.url}/#local-business`,
    name: company.name,
    description: company.description,
    url: company.url,
    telephone: company.phone,
    email: company.email,
    image: `${company.url}${brandAssets.fullLogo}`,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      addressLocality: company.address.city,
      addressCountry: company.address.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: company.geo.latitude,
      longitude: company.geo.longitude,
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '19:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Saturday'],
        opens: '10:00',
        closes: '14:00',
      },
    ],
    areaServed: [
      { '@type': 'City', name: 'Addis Ababa' },
      { '@type': 'Country', name: 'Ethiopia' },
    ],
  },
];
---

<BaseLayout
  title="Arada Tech"
  description="Custom websites, web apps, mobile apps, and business software in Addis Ababa, Ethiopia. Arada Tech, software development since 2016. Book a free consultation."
  structuredData={structuredData}
>
  <HeroSection />

  {/* Mobile: app-like sales journey replaces heavy desktop sections */}
  <MobileExperience />

  {/* Desktop: full sections (hidden on mobile) */}
  <div class="hidden md:block">
    <ServicesGrid />
    <WhyChooseUs />
    <ProcessSection />
    <PortfolioShowcase />
    <TestimonialsSection />
    <BlogPreview />
  </div>

  <section class="hidden md:block section-padding section-gap bg-neutral-50 border-t border-neutral-200/80" aria-labelledby="homepage-about-heading">
    <div class="section-container max-w-4xl">
      <h2 id="homepage-about-heading" class="heading-md text-neutral-900 mb-6">
        Software development partner for Ethiopian businesses and international teams
      </h2>
      <div class="prose-content space-y-4 text-neutral-700">
        <p>
          Arada Tech is a product-minded engineering studio in {company.address.city}. We replace manual workflows, spreadsheets, and legacy tools with websites,{' '}
          <a href="/services/web-application-development/" class="text-primary-600 font-medium hover:underline">web applications</a>,{' '}
          <a href="/services/mobile-app-development/" class="text-primary-600 font-medium hover:underline">mobile apps</a>, and{' '}
          <a href="/services/custom-software-development/" class="text-primary-600 font-medium hover:underline">custom software</a> that your team can run every day.
        </p>
        <p>
          Our projects span healthcare, finance, real estate operations, clearing and document services, and professional services firms. Discovery starts with mapping users, approvals, integrations,{' '}
          and reporting expectations, then design and delivery follow with staging environments, QA, documentation, and post-launch support so operations stay predictable.
        </p>
        <p>
          If you are headquartered in Ethiopia or collaborating with teams abroad, we can structure milestones, integrations,{' '}
          and hosting to match procurement, compliance, and performance needs. Start with a{' '}
          <a href="/contact/" class="text-primary-600 font-medium hover:underline">free consultation</a>{' '}
          or browse the <a href="/portfolio/" class="text-primary-600 font-medium hover:underline">portfolio</a>{' '} for similar systems.
        </p>
      </div>
    </div>
  </section>

  <CTA variant="gradient" />
</BaseLayout>

<script>
  function scheduleHomeBoot() {
    const run = () => {
      (async () => {
        const [{ initSmoothScroll }, anim] = await Promise.all([
          import('@scripts/smooth-scroll'),
          import('@scripts/scroll-animations'),
        ]);
        initSmoothScroll();
        anim.initHeroAnimations();
        anim.initScrollAnimations();
        anim.initCountUp();
        anim.initMagneticButtons();
        anim.initTiltCards();
        anim.initMobileExperienceAnimations();
      })().catch(() => {});
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      window.setTimeout(run, 180);
    }
  }

  scheduleHomeBoot();
</script>
