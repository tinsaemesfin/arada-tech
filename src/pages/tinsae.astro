---
/**
 * /tinsae/ — personal portfolio of Tinsae Mesfin.
 * Deliberately standalone: its own head, type, colour and motion. It does not use the Arada Tech layout.
 */
import {
  profile,
  stats,
  manifesto,
  skillGroups,
  projects,
  moreWork,
  experience,
  education,
  certifications,
  marquee,
} from '@data/tinsae';

const title = `${profile.name} — ${profile.titleLine}`;
const description = `${profile.headline} ${profile.intro}`;
const canonical = new URL('/tinsae/', Astro.site).href;
const ogImage = new URL('/images/tinsae-og.jpg', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${canonical}#person`,
  name: profile.name,
  url: canonical,
  image: new URL(profile.avatar, Astro.site).href,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Addis Ababa', addressCountry: 'ET' },
  worksFor: { '@type': 'Organization', name: 'BroadReach' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  hasCredential: certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    recognizedBy: { '@type': 'Organization', name: c.issuer },
  })),
  knowsAbout: skillGroups.flatMap((g) => g.items),
  sameAs: [profile.linkedin, profile.github, profile.x, 'https://www.aradatech.com/'],
};

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];

const marqueeItems = [...marquee, ...marquee];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" dir="ltr" class="tm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="profile:first_name" content="Tinsae" />
    <meta property="profile:last_name" content="Mesfin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@tinsaemesfin" />

    <link rel="icon" href="/images/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="preload" as="image" href={profile.avatar} />

    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-QQFLT5F53H"></script>
        <script is:inline defer>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-QQFLT5F53H');
        </script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <noscript><style>#tm-loader { display: none !important; }</style></noscript>
  </head>

  <body>
    <!-- Preloader -->
    <div id="tm-loader" aria-hidden="true">
      <div class="tm-loader__word-mask"><span id="tm-loader-word">Tinsae Mesfin</span></div>
      <div class="tm-loader__count"><span id="tm-loader-count">000</span></div>
    </div>

    <!-- Custom cursor -->
    <div id="tm-cursor" aria-hidden="true"><span class="tm-cursor__label"></span></div>

    <a href="#main" class="tm-skip">Skip to content</a>

    <!-- Nav -->
    <header class="tm-nav">
      <div class="tm-nav__inner">
        <a href="#top" class="tm-nav__brand" data-nav-item aria-label={`${profile.name}, back to top`}>
          <span class="tm-nav__mark">TM</span>
          <span class="tm-nav__name">{profile.name}</span>
        </a>

        <nav class="tm-nav__links" aria-label="Sections">
          {navLinks.map((l) => (
            <a href={l.href} data-nav-item>{l.label}</a>
          ))}
        </nav>

        <div class="tm-nav__actions">
          <a href={profile.resume} class="tm-btn tm-btn--ghost tm-btn--sm" data-nav-item data-magnetic="0.25" download>
            <span data-magnetic-inner>Résumé</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13m0 0l-5-5m5 5l5-5M4 21h16"/></svg>
          </a>
          <a href="#contact" class="tm-btn tm-btn--accent tm-btn--sm" data-nav-item data-magnetic="0.25">
            <span data-magnetic-inner>Say hello</span>
          </a>
          <button id="tm-menu-toggle" class="tm-nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="tm-mobile-menu" data-nav-item>
            <span></span><span></span>
          </button>
        </div>
      </div>

      <div id="tm-mobile-menu" class="tm-nav__mobile">
        {navLinks.map((l, i) => (
          <a href={l.href}><span class="mono">0{i + 1}</span>{l.label}</a>
        ))}
        <a href={profile.resume} download><span class="mono">↓</span>Download résumé</a>
      </div>
    </header>

    <main id="main">
      <!-- ============================== HERO ============================== -->
      <section id="hero" class="tm-hero" data-section>
        <span id="top"></span>
        <canvas id="hero-canvas" class="tm-hero__canvas" aria-hidden="true"></canvas>

        <div class="tm-hero__inner">
          <div class="tm-hero__top">
            <p class="tm-eyebrow" data-hero-side>
              <span class="tm-dot" aria-hidden="true"></span>
              {profile.role} <span class="tm-eyebrow__sep">/</span> {profile.roleAlt}
            </p>
            <p class="tm-eyebrow tm-eyebrow--right" data-hero-side>
              {profile.location} <span class="tm-eyebrow__sep">·</span> {profile.timezoneLabel} <span class="tm-eyebrow__sep">·</span> <span id="tm-clock" data-tz={profile.timezone}>--:--:--</span>
            </p>
          </div>

          <h1 class="hero-title" aria-label={profile.name}>
            <span class="line" aria-hidden="true">Tinsae</span>
            <span class="line line--second" aria-hidden="true">Mesfin</span>
          </h1>

          <div class="tm-hero__bottom">
            <div class="tm-hero__copy">
              <p class="tm-hero__headline" data-hero-sub>
                I turn messy business workflows into products people <em>actually use.</em>
              </p>
              <p class="tm-hero__intro" data-hero-sub>{profile.intro}</p>
              <div class="tm-hero__cta" data-hero-sub>
                <a href="#work" class="tm-btn tm-btn--accent tm-btn--lg" data-magnetic="0.3">
                  <span data-magnetic-inner>See the work</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
                </a>
                <a href={profile.resume} class="tm-btn tm-btn--outline tm-btn--lg" data-magnetic="0.3" download>
                  <span data-magnetic-inner>Download résumé</span>
                </a>
              </div>
            </div>

            <div class="tm-hero__portrait" data-hero-side>
              <div class="tm-portrait">
                <img src={profile.avatar} alt={`Portrait of ${profile.name}`} width="1254" height="1254" fetchpriority="high" />
                <svg class="tm-portrait__ring" viewBox="0 0 200 200" aria-hidden="true">
                  <defs>
                    <path id="ringPath" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" />
                  </defs>
                  <text>
                    <textPath href="#ringPath" startOffset="0">
                      {profile.ringText}
                    </textPath>
                  </text>
                </svg>
              </div>
            </div>
          </div>

          <div class="tm-hero__scroll" data-hero-side aria-hidden="true">
            <span class="mono">Scroll</span>
            <span class="tm-hero__scroll-line"><i></i></span>
          </div>
        </div>
      </section>

      <!-- ============================== MARQUEE ============================== -->
      <div class="tm-marquee" aria-hidden="true">
        <div class="tm-marquee__track" data-dir="ltr">
          {marqueeItems.map((item) => (
            <span class="tm-marquee__item"><i>✦</i>{item}</span>
          ))}
        </div>
      </div>

      <!-- ============================== ABOUT ============================== -->
      <section id="about" class="tm-section" data-section>
        <div class="tm-container">
          <p class="tm-label" data-reveal="fade"><span>01</span>About</p>

          <p id="manifesto-text" class="tm-manifesto">{manifesto}</p>

          <div class="tm-stats" data-reveal-group data-stagger="0.12">
            {stats.map((s) => (
              <div class="tm-stat">
                <p class="tm-stat__value"><span data-count={s.value}>0</span>{s.suffix}</p>
                <p class="tm-stat__label">{s.label}</p>
              </div>
            ))}
          </div>

          <div class="tm-modes" data-reveal-group data-stagger="0.14">
            <article class="tm-mode">
              <span class="mono tm-mode__index">Discover</span>
              <h3>Find the real problem.</h3>
              <p>Stakeholder interviews, process mapping, usability audits. I write the requirement so an engineer and a finance manager read the same thing.</p>
            </article>
            <article class="tm-mode">
              <span class="mono tm-mode__index">Design</span>
              <h3>Draw the workflow, then the screens.</h3>
              <p>Figma prototypes, design systems and tokens, accessibility baked in. Handoff that engineers do not have to guess at.</p>
            </article>
            <article class="tm-mode">
              <span class="mono tm-mode__index">Deliver</span>
              <h3>Build it, ship it, stay with it.</h3>
              <p>React, Next.js, TypeScript, Postgres, Supabase. Schemas, APIs, deployments, and the AI integrations that now live inside real products.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============================== SKILLS ============================== -->
      <section id="skills" class="tm-section tm-section--tint" data-section>
        <div class="tm-container">
          <div class="tm-section__head">
            <p class="tm-label" data-reveal="fade"><span>02</span>Capabilities</p>
            <h2 class="tm-h2" data-split-lines>Full stack, in the honest sense of the word.</h2>
            <p class="tm-lede" data-reveal>
              Six areas I work in every week. Not a list of logos, a description of what I can own on a team.
            </p>
          </div>

          <div class="tm-skills" data-reveal-group data-stagger="0.1">
            {skillGroups.map((g) => (
              <article class="tm-skill" data-tilt style={`--accent:${g.accent}`}>
                <div class="tm-skill__glow" aria-hidden="true"></div>
                <header class="tm-skill__head">
                  <span class="mono tm-skill__index">{g.index}</span>
                  {g.index === '05' && <span class="tm-skill__badge">In active use</span>}
                </header>
                <h3 class="tm-skill__title">{g.title}</h3>
                <p class="tm-skill__blurb">{g.blurb}</p>
                <ul class="tm-skill__list">
                  {g.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================== WORK ============================== -->
      <section id="work" class="tm-section" data-section>
        <div class="tm-container">
          <div class="tm-section__head">
            <p class="tm-label" data-reveal="fade"><span>03</span>Selected work</p>
            <h2 class="tm-h2" data-split-lines>Products with real users and real numbers.</h2>
            <p class="tm-lede" data-reveal>
              Each of these started as a workflow on a whiteboard. Most of them I designed and built; two of them I founded.
            </p>
          </div>

          <div class="tm-work">
            <aside class="tm-work__side" aria-hidden="true">
              <span class="tm-work__counter"><span id="work-counter">01</span><small>/ {String(projects.length).padStart(2, '0')}</small></span>
            </aside>

            <div class="tm-work__stack">
              {projects.map((p) => (
                <article class="work-card" style={`--tone:${p.tone}`} id={`work-${p.index}`}>
                  <div class="work-card__inner">
                    <div class="work-card__body">
                      <div class="work-card__meta mono">
                        <span>{p.index}</span>
                        <span>{p.org}</span>
                        <span>{p.year}</span>
                      </div>
                      <h3 class="work-card__title">{p.title}</h3>
                      <p class="work-card__role">{p.role}</p>
                      <p class="work-card__summary">{p.summary}</p>
                      <ul class="work-card__outcomes">
                        {p.outcomes.map((o) => (
                          <li>
                            <strong>{o.value}</strong>
                            <span>{o.label}</span>
                          </li>
                        ))}
                      </ul>
                      <ul class="work-card__stack">
                        {p.stack.map((s) => (
                          <li>{s}</li>
                        ))}
                      </ul>
                      {p.link && (
                        <a
                          href={p.link.href}
                          class="tm-link"
                          target={p.link.external ? '_blank' : undefined}
                          rel={p.link.external ? 'noopener noreferrer' : undefined}
                        >
                          {p.link.label}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
                        </a>
                      )}
                    </div>

                    <div class="work-card__media" data-cursor="view" data-cursor-label={p.link ? 'View' : p.year}>
                      {p.image ? (
                        <div class="tm-frame">
                          <div class="tm-frame__bar"><i></i><i></i><i></i></div>
                          <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" />
                        </div>
                      ) : p.art === 'kpi' ? (
                        <div class="work-art work-art--kpi" aria-hidden="true">
                          <div class="work-art__label mono">Regulatory KPI · Q3</div>
                          <div class="kpi-bars">
                            {[62, 74, 58, 81, 90, 77, 95].map((v, i) => (
                              <span class="kpi-bar" style={`--h:${v}%; --d:${i * 90}ms`}></span>
                            ))}
                            <span class="kpi-target"><em>target 85%</em></span>
                          </div>
                          <div class="kpi-tip">
                            <span class="mono">Inspections closed</span>
                            <strong>88%</strong>
                            <small>driver: backlog in region 4</small>
                          </div>
                        </div>
                      ) : (
                        <div class="work-art work-art--rent" aria-hidden="true">
                          <div class="rent-building">
                            {Array.from({ length: 30 }).map((_, i) => (
                              <span class={`rent-window ${[2, 5, 9, 14, 17, 21, 26].includes(i) ? 'is-lit' : ''}`}></span>
                            ))}
                          </div>
                          <div class="rent-receipt">
                            <span class="mono">Receipt #0231</span>
                            <strong>ETB 18,500</strong>
                            <small>Telebirr · verified ✓</small>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="tm-more" data-reveal>
            <p class="tm-label"><span>+</span>Also</p>
            <ul class="tm-more__list">
              {moreWork.map((m) => (
                <li>
                  {m.href ? <a href={m.href} class="tm-more__title">{m.title}</a> : <span class="tm-more__title">{m.title}</span>}
                  <span class="tm-more__note">{m.note}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ============================== EXPERIENCE ============================== -->
      <section id="experience" class="tm-section tm-section--tint" data-section>
        <div class="tm-container">
          <div class="tm-section__head">
            <p class="tm-label" data-reveal="fade"><span>04</span>Experience</p>
            <h2 class="tm-h2" data-split-lines>Engineer, design lead, analyst, acting CTO. Same person, different hats.</h2>
          </div>

          <div class="tm-xp">
            <div class="tm-xp__rail" aria-hidden="true"><span id="xp-line"></span></div>
            <ol id="xp-list" class="tm-xp__list">
              {experience.map((x) => (
                <li class="xp-item" data-reveal>
                  <div class="xp-item__when">
                    <span class="mono">{x.period}</span>
                    {x.current && <span class="xp-item__now">Now</span>}
                  </div>
                  <div class="xp-item__dot" aria-hidden="true"></div>
                  <div class="xp-item__what">
                    <h3>{x.role}</h3>
                    <p class="xp-item__org">{x.company} <span>· {x.location}</span></p>
                    <ul>
                      {x.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <div class="tm-creds" data-reveal-group data-stagger="0.12">
            <article class="tm-cred tm-cred--edu">
              <p class="tm-label"><span>◆</span>Education</p>
              <h3>{education.degree}</h3>
              <p>{education.school} <span class="mono">· {education.period} · {education.note}</span></p>
            </article>
            <article class="tm-cred">
              <p class="tm-label"><span>◆</span>Certifications</p>
              <ul class="tm-cred__list">
                {certifications.map((c) => (
                  <li><strong>{c.name}</strong><span class="mono">{c.issuer}</span></li>
                ))}
              </ul>
            </article>
          </div>
        </div>
      </section>

      <!-- ============================== CONTACT ============================== -->
      <section id="contact" class="tm-contact" data-section>
        <div class="tm-contact__big" aria-hidden="true">
          <span id="contact-big">Let’s build something that ships — Let’s build something that ships —</span>
        </div>

        <div class="tm-container">
          <div class="tm-contact__grid">
            <div class="tm-contact__main">
              <p class="tm-label" data-reveal="fade"><span>05</span>Contact</p>
              <h2 class="tm-h2" data-split-lines>If this looks like the person your team is missing, let’s talk.</h2>
              <p class="tm-lede" data-reveal>{profile.availability}</p>

              <div class="tm-contact__email" data-reveal>
                <a href={`mailto:${profile.email}`} class="tm-contact__mail" data-cursor="view" data-cursor-label="Email">
                  {profile.email}
                </a>
                <button type="button" class="tm-copy" data-copy={profile.email} aria-label="Copy email address">
                  <span class="tm-copy__idle">Copy</span>
                  <span class="tm-copy__done">Copied</span>
                </button>
              </div>
            </div>

            <ul class="tm-contact__links" data-reveal-group>
              <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer me"><span class="mono">01</span>LinkedIn<i>↗</i></a></li>
              <li><a href={profile.github} target="_blank" rel="noopener noreferrer me"><span class="mono">02</span>GitHub<i>↗</i></a></li>
              <li><a href={profile.x} target="_blank" rel="noopener noreferrer me"><span class="mono">03</span>X / Twitter<i>↗</i></a></li>
              <li><a href={`tel:${profile.phoneRaw}`}><span class="mono">04</span>{profile.phone}<i>↗</i></a></li>
              <li><a href={profile.resume} download><span class="mono">05</span>Résumé (PDF)<i>↓</i></a></li>
            </ul>
          </div>
        </div>

        <footer class="tm-footer">
          <div class="tm-container tm-footer__inner">
            <p>© {year} {profile.name}. {profile.location}.</p>
            <p>Designed and built by me with Astro, GSAP and Lenis. Also the founder of <a href="/">Arada Tech</a>.</p>
            <a href="#top" class="tm-footer__top">Back to top ↑</a>
          </div>
        </footer>
      </section>
    </main>

    <script>
      import { initTinsaePortfolio } from '@scripts/tinsae-portfolio';
      const boot = () => initTinsaePortfolio();
      if (document.fonts?.ready) {
        Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]).then(boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>

<style is:global>
  /* ────────────────────────────── tokens ────────────────────────────── */
  html.tm {
    --tm-bg: #0a0a0c;
    --tm-bg-2: #0f0f12;
    --tm-surface: #141418;
    --tm-ink: #f2efe8;
    --tm-ink-2: #c9c6be;
    --tm-muted: #8e8d95;
    --tm-line: rgba(242, 239, 232, 0.1);
    --tm-line-strong: rgba(242, 239, 232, 0.22);
    --tm-accent: #d9f94c;
    --tm-accent-ink: #0a0a0c;
    --tm-violet: #7b61ff;
    --tm-nav-h: 4.5rem;
    --tm-gutter: clamp(1.25rem, 4vw, 3.5rem);
    --tm-section: clamp(5rem, 12vw, 11rem);
    --font-sans: 'Inter Tight', 'Inter', system-ui, -apple-system, sans-serif;
    --font-serif: 'Instrument Serif', Georgia, serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    color-scheme: dark;
    background: var(--tm-bg);
    scroll-behavior: auto;
  }
  html.tm.has-cursor,
  html.tm.has-cursor * { cursor: none !important; }
  html.tm.menu-open { overflow: hidden; }

  html.tm body {
    margin: 0;
    background: var(--tm-bg);
    color: var(--tm-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  html.tm ::selection { background: var(--tm-accent); color: var(--tm-accent-ink); }
  :where(html.tm) a { color: inherit; text-decoration: none; }
  :where(html.tm) img { display: block; max-width: 100%; height: auto; }
  :where(html.tm) ul, :where(html.tm) ol { list-style: none; margin: 0; padding: 0; }
  :where(html.tm) h1, :where(html.tm) h2, :where(html.tm) h3, :where(html.tm) p { margin: 0; }
  :where(html.tm) button { font: inherit; color: inherit; background: none; border: 0; padding: 0; }
  .mono { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .tm-skip {
    position: fixed; top: 0.75rem; left: 0.75rem; z-index: 200; padding: 0.6rem 1rem;
    background: var(--tm-accent); color: var(--tm-accent-ink); border-radius: 999px; font-weight: 600;
    transform: translateY(-200%); transition: transform 0.2s;
  }
  .tm-skip:focus { transform: none; }

  /* ────────────────────────────── loader ────────────────────────────── */
  #tm-loader {
    position: fixed; inset: 0; z-index: 150; background: var(--tm-bg);
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: var(--tm-gutter); pointer-events: none;
  }
  .tm-loader__word-mask { overflow: hidden; }
  #tm-loader-word { display: block; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 4vw, 3rem); color: var(--tm-ink); }
  .tm-loader__count { font-family: var(--font-sans); font-weight: 800; font-size: clamp(4rem, 14vw, 12rem); line-height: 0.85; letter-spacing: -0.05em; color: var(--tm-accent); font-variant-numeric: tabular-nums; }

  /* ────────────────────────────── cursor ────────────────────────────── */
  #tm-cursor {
    position: fixed; top: 0; left: 0; z-index: 140; pointer-events: none;
    width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    background: var(--tm-ink); opacity: 0;
    display: grid; place-items: center;
    transition: width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), margin 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s, opacity 0.3s;
    mix-blend-mode: difference;
  }
  #tm-cursor.is-visible { opacity: 1; }
  #tm-cursor .tm-cursor__label { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tm-accent-ink); opacity: 0; transition: opacity 0.2s; }
  #tm-cursor[data-state='link'] { width: 40px; height: 40px; margin: -20px 0 0 -20px; background: rgba(242, 239, 232, 0.85); }
  #tm-cursor[data-state='view'] { width: 92px; height: 92px; margin: -46px 0 0 -46px; background: var(--tm-accent); mix-blend-mode: normal; }
  #tm-cursor[data-state='view'] .tm-cursor__label { opacity: 1; }

  /* ────────────────────────────── nav ────────────────────────────── */
  .tm-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 120;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .tm-nav.is-scrolled { background: rgba(10, 10, 12, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--tm-line); }
  .tm-nav.is-hidden:not(.is-open) { transform: translateY(-100%); }
  .tm-nav__inner { height: var(--tm-nav-h); padding: 0 var(--tm-gutter); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .tm-nav__brand { display: inline-flex; align-items: center; gap: 0.75rem; font-weight: 600; letter-spacing: -0.01em; }
  .tm-nav__mark { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.6rem; background: var(--tm-accent); color: var(--tm-accent-ink); font-family: var(--font-mono); font-weight: 500; font-size: 0.78rem; letter-spacing: 0.02em; }
  .tm-nav__name { font-size: 0.95rem; }
  .tm-nav__links { display: none; gap: 0.25rem; }
  .tm-nav__links a { position: relative; padding: 0.5rem 0.85rem; font-size: 0.9rem; color: var(--tm-ink-2); border-radius: 999px; transition: color 0.2s, background 0.2s; }
  .tm-nav__links a:hover { color: var(--tm-ink); }
  .tm-nav__links a.is-active { color: var(--tm-ink); background: rgba(242, 239, 232, 0.06); }
  .tm-nav__actions { display: flex; align-items: center; gap: 0.5rem; }
  .tm-nav__toggle { position: relative; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--tm-line-strong); display: grid; place-items: center; }
  .tm-nav__toggle span { position: absolute; width: 1rem; height: 1.5px; background: var(--tm-ink); transition: transform 0.3s; }
  .tm-nav__toggle span:first-child { transform: translateY(-3px); }
  .tm-nav__toggle span:last-child { transform: translateY(3px); }
  .tm-nav.is-open .tm-nav__toggle span:first-child { transform: rotate(45deg); }
  .tm-nav.is-open .tm-nav__toggle span:last-child { transform: rotate(-45deg); }
  .tm-nav__mobile {
    position: fixed; inset: var(--tm-nav-h) 0 0 0; background: var(--tm-bg); padding: 2rem var(--tm-gutter);
    display: flex; flex-direction: column; gap: 0.25rem;
    clip-path: inset(0 0 100% 0); transition: clip-path 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .tm-nav.is-open .tm-nav__mobile { clip-path: inset(0 0 0 0); }
  .tm-nav__mobile a { display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--tm-line); font-size: clamp(1.75rem, 7vw, 2.5rem); font-weight: 600; letter-spacing: -0.02em; }
  .tm-nav__mobile a .mono { color: var(--tm-accent); }
  @media (min-width: 1024px) {
    .tm-nav__links { display: flex; }
    .tm-nav__toggle, .tm-nav__mobile { display: none; }
  }
  @media (max-width: 1023px) {
    .tm-nav__actions .tm-btn--ghost { display: none; }
  }
  @media (max-width: 480px) {
    .tm-nav__name { display: none; }
  }

  /* ────────────────────────────── buttons ────────────────────────────── */
  .tm-btn {
    position: relative; display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.9rem 1.5rem; border-radius: 999px; font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em;
    border: 1px solid transparent; white-space: nowrap; overflow: hidden; isolation: isolate;
    transition: color 0.3s, border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .tm-btn--sm { padding: 0.6rem 1.05rem; font-size: 0.85rem; }
  .tm-btn--lg { padding: 1.05rem 1.8rem; font-size: 1rem; }
  .tm-btn--accent, .tm-btn--accent:hover { background: var(--tm-accent); color: var(--tm-accent-ink); }
  .tm-btn--accent::after { content: ''; position: absolute; inset: 0; background: var(--tm-ink); border-radius: inherit; transform: translateY(101%); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: -1; }
  .tm-btn--accent:hover::after { transform: translateY(0); }
  .tm-btn--outline { border-color: var(--tm-line-strong); color: var(--tm-ink); }
  .tm-btn--outline:hover { border-color: var(--tm-ink); background: rgba(242, 239, 232, 0.05); }
  .tm-btn--ghost { color: var(--tm-ink-2); }
  .tm-btn--ghost:hover { color: var(--tm-ink); background: rgba(242, 239, 232, 0.06); }
  .tm-btn svg { flex: none; transition: transform 0.3s; }
  .tm-btn:hover svg { transform: translate(2px, -2px); }

  .tm-link { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--tm-ink); border-bottom: 1px solid var(--tm-line-strong); padding-bottom: 0.2rem; transition: border-color 0.25s, color 0.25s; }
  .tm-link:hover { color: var(--tone, var(--tm-accent)); border-color: currentColor; }
  .tm-link svg { transition: transform 0.3s; }
  .tm-link:hover svg { transform: translate(2px, -2px); }

  /* ────────────────────────────── layout ────────────────────────────── */
  .tm-container { width: min(100% - 2 * var(--tm-gutter), 88rem); margin-inline: auto; }
  .tm-section { position: relative; padding: var(--tm-section) 0; }
  .tm-section--tint { background: var(--tm-bg-2); border-top: 1px solid var(--tm-line); border-bottom: 1px solid var(--tm-line); }
  .tm-section__head { max-width: 56rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .tm-label { display: inline-flex; align-items: center; gap: 0.75rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tm-muted); margin-bottom: 1.5rem; }
  .tm-label span { color: var(--tm-accent); }
  .tm-label span::before { content: '('; margin-right: 0.2em; color: var(--tm-muted); }
  .tm-label span::after { content: ')'; margin-left: 0.2em; color: var(--tm-muted); }
  .tm-h2 { font-size: clamp(2.1rem, 5.2vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -0.035em; text-wrap: balance; }
  .tm-h2 .ln { display: block; }
  .tm-lede { margin-top: 1.5rem; max-width: 40rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); color: var(--tm-ink-2); line-height: 1.55; }

  /* ────────────────────────────── hero ────────────────────────────── */
  .tm-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; }
  .tm-hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .tm-hero::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 100%, rgba(10, 10, 12, 0.95), transparent 70%),
      radial-gradient(40% 40% at 85% 20%, rgba(123, 97, 255, 0.14), transparent 70%);
  }
  .tm-hero__inner { position: relative; z-index: 2; flex: 1; display: flex; flex-direction: column; padding: calc(var(--tm-nav-h) + 1rem) var(--tm-gutter) 1.5rem; }
  .tm-hero__top { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .tm-eyebrow { display: block; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tm-ink-2); line-height: 1.6; }
  .tm-eyebrow__sep { color: var(--tm-muted); }
  .tm-eyebrow--right { color: var(--tm-muted); }
  .tm-dot { display: inline-block; vertical-align: middle; margin: -2px 0.6rem 0 0; width: 8px; height: 8px; border-radius: 50%; background: var(--tm-accent); box-shadow: 0 0 0 0 rgba(217, 249, 76, 0.6); animation: tm-pulse 2s infinite; }
  @keyframes tm-pulse { 0% { box-shadow: 0 0 0 0 rgba(217, 249, 76, 0.6); } 70% { box-shadow: 0 0 0 10px rgba(217, 249, 76, 0); } 100% { box-shadow: 0 0 0 0 rgba(217, 249, 76, 0); } }

  .hero-title { margin: auto 0 0; padding-top: clamp(0.75rem, 3vh, 3rem); font-size: clamp(3.4rem, min(15.5vw, 21svh), 15.5rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.055em; text-transform: uppercase; color: var(--tm-ink); }
  .hero-title .line { display: block; overflow: hidden; padding: 0.04em 0; perspective: 900px; }
  .hero-title .line--second { color: transparent; -webkit-text-stroke: 1.5px var(--tm-ink); margin-left: clamp(0rem, 8vw, 10rem); }
  .hero-title .ch { display: inline-block; transform-origin: 50% 100%; will-change: transform, opacity; }
  @media (max-width: 767px) { .hero-title { font-size: clamp(3.4rem, min(19vw, 21svh), 15.5rem); } }
  @media (min-width: 1024px) { .hero-title .line--second { color: transparent; } }

  .tm-hero__bottom { display: grid; gap: 2rem; margin-top: clamp(1rem, 3vh, 2.5rem); align-items: end; }
  .tm-hero__copy { max-width: 46rem; }
  .tm-hero__headline { font-size: clamp(1.35rem, min(2.6vw, 3.4svh), 2.3rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.025em; text-wrap: balance; }
  .tm-hero__headline em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--tm-accent); font-size: 1.12em; }
  .tm-hero__intro { margin-top: clamp(0.6rem, 1.4svh, 1.1rem); max-width: 36rem; color: var(--tm-ink-2); font-size: clamp(0.95rem, min(1.2vw, 1.9svh), 1.1rem); }
  .tm-hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1rem, 2.2svh, 1.75rem); }
  .tm-hero__portrait { display: none; justify-self: end; }
  .tm-portrait { position: relative; width: clamp(9rem, min(16vw, 24svh), 15rem); aspect-ratio: 1; }
  .tm-portrait img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 1px solid var(--tm-line-strong); filter: saturate(0.9) contrast(1.05); }
  .tm-portrait__ring { position: absolute; inset: -14%; width: 128%; height: 128%; animation: tm-spin 24s linear infinite; }
  .tm-portrait__ring text { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; fill: var(--tm-ink-2); }
  @keyframes tm-spin { to { transform: rotate(360deg); } }
  .tm-hero__scroll { position: absolute; left: var(--tm-gutter); bottom: 1.5rem; display: none; align-items: center; gap: 0.75rem; color: var(--tm-muted); }
  .tm-hero__scroll-line { position: relative; width: 1px; height: 3rem; background: var(--tm-line); overflow: hidden; }
  .tm-hero__scroll-line i { position: absolute; inset: 0; background: var(--tm-accent); transform-origin: top; animation: tm-scrollline 2.2s cubic-bezier(0.76, 0, 0.24, 1) infinite; }
  @keyframes tm-scrollline { 0% { transform: scaleY(0); transform-origin: top; } 45% { transform: scaleY(1); transform-origin: top; } 55% { transform: scaleY(1); transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (min-width: 768px) {
    .tm-hero__bottom { grid-template-columns: 1fr auto; }
    .tm-hero__portrait { display: block; }
    .tm-hero__scroll { display: flex; }
    .tm-hero__inner { padding-bottom: 4.75rem; }
  }
  /* Short laptop screens: drop the scroll cue, tighten the bottom so everything stays inside one viewport. */
  @media (min-width: 768px) and (max-height: 720px) {
    .tm-hero__scroll { display: none; }
    .tm-hero__inner { padding-bottom: 1.5rem; }
    .tm-hero__intro { display: none; }
  }

  /* ────────────────────────────── marquee ────────────────────────────── */
  .tm-marquee { position: relative; z-index: 3; overflow: hidden; border-top: 1px solid var(--tm-line); border-bottom: 1px solid var(--tm-line); background: var(--tm-accent); color: var(--tm-accent-ink); padding: 0.85rem 0; }
  .tm-marquee__track { display: flex; width: max-content; will-change: transform; }
  .tm-marquee__item { display: inline-flex; align-items: center; gap: 1.25rem; padding-right: 1.25rem; font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; white-space: nowrap; }
  .tm-marquee__item i { font-style: normal; font-size: 0.7rem; opacity: 0.6; }
  @media (prefers-reduced-motion: reduce) { .tm-marquee__track { width: 100%; flex-wrap: wrap; justify-content: center; } }

  /* ────────────────────────────── about ────────────────────────────── */
  .tm-manifesto { font-size: clamp(1.5rem, 3.4vw, 3rem); font-weight: 500; line-height: 1.18; letter-spacing: -0.03em; max-width: 64rem; text-wrap: pretty; }
  .tm-manifesto .w { display: inline-block; will-change: opacity; }
  .tm-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: clamp(3rem, 6vw, 5rem); background: var(--tm-line); border: 1px solid var(--tm-line); border-radius: 1.25rem; overflow: hidden; }
  .tm-stat { background: var(--tm-bg); padding: 1.75rem 1.5rem; }
  .tm-stat__value { font-size: clamp(2.6rem, 5vw, 4.5rem); font-weight: 700; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .tm-stat__label { margin-top: 0.6rem; color: var(--tm-muted); font-size: 0.92rem; max-width: 14rem; }
  @media (min-width: 768px) { .tm-stats { grid-template-columns: repeat(4, 1fr); } .tm-stat { padding: 2.25rem 2rem; } }
  .tm-modes { display: grid; gap: 1px; margin-top: clamp(3rem, 6vw, 5rem); background: var(--tm-line); border: 1px solid var(--tm-line); border-radius: 1.25rem; overflow: hidden; }
  .tm-mode { background: var(--tm-bg); padding: 2rem 1.75rem; position: relative; transition: background 0.3s; }
  .tm-mode:hover { background: var(--tm-surface); }
  .tm-mode__index { color: var(--tm-accent); display: block; margin-bottom: 1.25rem; }
  .tm-mode h3 { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .tm-mode p { margin-top: 0.75rem; color: var(--tm-ink-2); font-size: 0.98rem; }
  @media (min-width: 768px) { .tm-modes { grid-template-columns: repeat(3, 1fr); } .tm-mode { padding: 2.5rem 2.25rem; } }

  /* ────────────────────────────── skills ────────────────────────────── */
  .tm-skills { display: grid; gap: 1rem; perspective: 1400px; }
  .tm-skill {
    --mx: 50%; --my: 50%;
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--tm-surface); border: 1px solid var(--tm-line); border-radius: 1.5rem; padding: 1.75rem;
    transform-style: preserve-3d; transition: border-color 0.3s;
  }
  .tm-skill:hover { border-color: var(--tm-line-strong); }
  .tm-skill__glow { position: absolute; inset: -1px; z-index: -1; border-radius: inherit; opacity: 0; transition: opacity 0.4s; background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent) 22%, transparent), transparent 55%); }
  .tm-skill:hover .tm-skill__glow { opacity: 1; }
  .tm-skill__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .tm-skill__index { color: var(--accent); }
  .tm-skill__badge { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.35rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .tm-skill__title { font-size: 1.45rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
  .tm-skill__blurb { margin-top: 0.6rem; color: var(--tm-ink-2); font-size: 0.95rem; min-height: 2.9em; }
  .tm-skill__list { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.5rem; }
  .tm-skill__list li { font-size: 0.82rem; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid var(--tm-line); color: var(--tm-ink-2); background: rgba(242, 239, 232, 0.03); transition: border-color 0.25s, color 0.25s, background 0.25s; }
  .tm-skill:hover .tm-skill__list li { border-color: color-mix(in srgb, var(--accent) 35%, transparent); }
  .tm-skill__list li:hover { color: var(--tm-ink); background: color-mix(in srgb, var(--accent) 18%, transparent); }
  @media (min-width: 640px) { .tm-skills { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .tm-skills { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } .tm-skill { padding: 2.25rem; } }

  /* ────────────────────────────── work ────────────────────────────── */
  .tm-work { display: grid; gap: 2rem; }
  .tm-work__side { display: none; }
  .tm-work__counter { position: sticky; top: calc(var(--tm-nav-h) + 2rem); display: block; font-size: clamp(4rem, 8vw, 9rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.06em; color: var(--tm-ink); font-variant-numeric: tabular-nums; }
  .tm-work__counter small { display: block; margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--tm-muted); }
  .tm-work__stack { display: grid; gap: 1.25rem; }
  .work-card { --dim: 0; position: relative; will-change: transform; transform-origin: 50% 0; }
  .work-card__inner::after { content: ''; position: absolute; inset: 0; z-index: 5; pointer-events: none; background: var(--tm-bg); opacity: var(--dim); border-radius: inherit; }
  .work-card__inner {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--tm-surface); border: 1px solid var(--tm-line); border-radius: 1.75rem;
    display: grid; gap: 1.5rem; padding: 1.5rem;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .work-card__inner::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 60% at 0% 0%, color-mix(in srgb, var(--tone) 16%, transparent), transparent 60%); }
  .work-card__meta { display: flex; gap: 1.25rem; color: var(--tm-muted); margin-bottom: 1.25rem; flex-wrap: wrap; }
  .work-card__meta span:first-child { color: var(--tone); }
  .work-card__title { font-size: clamp(1.7rem, 3vw, 2.6rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .work-card__role { margin-top: 0.6rem; font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; color: var(--tm-ink-2); }
  .work-card__summary { margin-top: 1.25rem; color: var(--tm-ink-2); font-size: 0.98rem; line-height: 1.6; max-width: 36rem; }
  .work-card__outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--tm-line); }
  .work-card__outcomes strong { display: block; font-size: clamp(1.1rem, 1.6vw, 1.45rem); font-weight: 700; letter-spacing: -0.03em; color: var(--tone); line-height: 1.1; }
