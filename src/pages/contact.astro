---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import { company } from '@data/company';

const breadcrumbs = [{ name: 'Contact', href: '/contact/' }];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Arada Tech',
  description: 'Get in touch with Arada Tech for software development, website design, and mobile app development in Addis Ababa, Ethiopia.',
  url: new URL('/contact/', Astro.site).href,
  mainEntity: {
    '@type': 'Organization',
    '@id': `${company.url}/#organization`,
    name: company.name,
    url: company.url,
    email: company.email,
    telephone: company.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      addressLocality: company.address.city,
      addressCountry: company.address.countryCode,
    },
  },
};
---

<BaseLayout
  title="Contact Us | Get a Free Consultation"
  description="Contact Arada Tech in Addis Ababa: free consultation for websites, web apps, mobile apps, custom software, and UI/UX. We reply within one business day."
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section-padding pb-0">
    <div class="section-container max-w-4xl mx-auto text-center">
      <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider mb-3 block reveal-up">Contact Us</span>
      <h1 class="heading-xl mb-6 reveal-up">Let's Talk About Your Project</h1>
      <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed max-w-3xl mx-auto reveal-up">
        Whether you have a clear project brief or just an idea, we would love to hear from you. Reach out and let's explore how we can help.
      </p>
    </div>
  </section>

  <section class="section-gap">
    <div class="section-padding">
      <div class="section-container">
        <div class="grid lg:grid-cols-5 gap-12">
          <!-- Contact Info -->
          <div class="lg:col-span-2 reveal-left">
            <h2 class="heading-md mb-6">Get in Touch</h2>
            <div class="space-y-6 mb-8">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <div>
                  <div class="font-semibold text-neutral-900 mb-1">Phone</div>
                  <a href={`tel:${company.phoneRaw}`} class="text-neutral-600 hover:text-primary-500 transition-colors">{company.phone}</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <div class="font-semibold text-neutral-900 mb-1">Email</div>
                  <a href={`mailto:${company.email}`} class="text-neutral-600 hover:text-primary-500 transition-colors">{company.email}</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <div>
                  <div class="font-semibold text-neutral-900 mb-1">Office</div>
                  <span class="text-neutral-600">{company.address.street}, {company.address.city}, {company.address.country}</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <div class="font-semibold text-neutral-900 mb-1">Working Hours</div>
                  <span class="text-neutral-600">Mon to Fri: 9:00 AM to 7:00 PM</span><br />
                  <span class="text-neutral-600">Saturday: 10:00 AM to 2:00 PM</span>
                </div>
              </div>
            </div>

            <div class="p-6 bg-primary-50 rounded-2xl">
              <h3 class="font-bold text-neutral-900 mb-2">Prefer a call?</h3>
              <p class="text-sm text-neutral-600 mb-4">Schedule a free 30 minute consultation to discuss your project needs.</p>
              <a href={`tel:${company.phoneRaw}`} class="btn-primary w-full justify-center">Call Us Now</a>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="lg:col-span-3 reveal-right">
            <div class="card p-8">
              <h2 class="heading-sm mb-6">Send Us a Message</h2>

              <div id="form-success" class="hidden mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-green-800 text-sm">
                Thank you! Your message has been sent successfully. We'll get back to you within 24 hours.
              </div>
              <div id="form-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-800 text-sm">
                Something went wrong.
              </div>

              <form id="contact-form" class="space-y-5" novalidate>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">Full Name <span class="text-red-500">*</span></label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="w-full px-4 py-3 rounded-lg border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                      placeholder="Your full name"
                    />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">Email <span class="text-red-500">*</span></label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-4 py-3 rounded-lg border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                      placeholder="your@email.com"
                    />
                  </div>
                </div>

                <div>
                  <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1.5">Phone (optional)</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="w-full px-4 py-3 rounded-lg border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    placeholder="+251 9XX XXX XXX"
                  />
                </div>

                <div>
                  <label for="service" class="block text-sm font-medium text-neutral-700 mb-1.5">Service Interested In</label>
                  <select
                    id="service"
                    name="service"
                    class="w-full px-4 py-3 rounded-lg border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors bg-white"
                  >
                    <option value="">Select a service</option>
                    <option value="Website Development">Website Development</option>
                    <option value="Web Application Development">Web Application Development</option>
                    <option value="Mobile App Development">Mobile App Development</option>
                    <option value="Custom Software Development">Custom Software Development</option>
                    <option value="UI/UX Design">UI/UX Design</option>
                    <option value="Other">Other / Not Sure</option>
                  </select>
                </div>

                <div>
                  <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">Message <span class="text-red-500">*</span></label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="5"
                    class="w-full px-4 py-3 rounded-lg border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors resize-y"
                    placeholder="Tell us about your project..."
                  ></textarea>
                </div>

                <!-- Honeypot -->
                <div class="hidden" aria-hidden="true">
                  <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </div>

                <button type="submit" class="btn-primary btn-lg w-full justify-center">
                  Send Message
                </button>

                <p class="text-xs text-neutral-500 text-center">
                  We typically respond within 24 hours. Your information is kept confidential per our <a href="/privacy-policy/" class="text-primary-500 hover:underline">privacy policy</a>.
                </p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initScrollAnimations } from '@scripts/scroll-animations';
  import { initContactForm } from '@scripts/contact-form';
  initScrollAnimations();
  initContactForm();
</script>
