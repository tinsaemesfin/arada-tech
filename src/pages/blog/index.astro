---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import CTA from '@components/global/CTA.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [{ name: 'Blog', href: '/blog/' }];

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const categories =
  posts.length > 0 ? ['All', ...new Set(posts.map((p) => p.data.category))] : ['All'];

const categoryColors: Record<string, { bg: string; text: string; dot: string }> = {
  Technology: { bg: 'bg-blue-50', text: 'text-blue-600', dot: 'bg-blue-500' },
  Business: { bg: 'bg-emerald-50', text: 'text-emerald-600', dot: 'bg-emerald-500' },
  Design: { bg: 'bg-purple-50', text: 'text-purple-600', dot: 'bg-purple-500' },
  Development: { bg: 'bg-orange-50', text: 'text-orange-600', dot: 'bg-orange-500' },
  'Mobile Development': { bg: 'bg-pink-50', text: 'text-pink-600', dot: 'bg-pink-500' },
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog - Insights on Software Development',
  description: 'Insights, guides, and articles on software development, web design, mobile apps, and technology for businesses in Ethiopia.',
  url: new URL('/blog/', Astro.site).href,
};

const featuredDate = featuredPost
  ? new Date(featuredPost.data.publishDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
const featuredCat = featuredPost
  ? categoryColors[featuredPost.data.category] || {
      bg: 'bg-primary-50',
      text: 'text-primary-600',
      dot: 'bg-primary-500',
    }
  : { bg: 'bg-primary-50', text: 'text-primary-600', dot: 'bg-primary-500' };
---

<BaseLayout
  title="Blog | Software Insights, Ethiopia"
  description="Software development articles for Ethiopian businesses: web, mobile, UI/UX, and digital strategy. Insights from Arada Tech in Addis Ababa."
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-500 via-primary-600 to-primary-800">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-secondary-400/10 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] rounded-full bg-primary-300/20 blur-3xl"></div>
      <div class="absolute top-1/4 right-1/3 w-2 h-2 bg-white/20 rounded-full"></div>
      <div class="absolute bottom-1/3 left-1/4 w-3 h-3 bg-secondary-400/20 rounded-full"></div>
      <div class="absolute top-1/2 right-1/4 w-1.5 h-1.5 bg-white/15 rounded-full"></div>
    </div>

    <div class="section-padding relative">
      <div class="max-w-6xl mx-auto pt-8 pb-14 sm:pt-14 sm:pb-16 lg:pt-16 lg:pb-20 text-center">
        <span class="inline-block px-4 py-1.5 bg-white/10 backdrop-blur-sm text-secondary-300 text-sm font-semibold rounded-full uppercase tracking-wider mb-6 reveal-up">
          Our Blog
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-6 reveal-up">
          Insights &<br class="hidden sm:block" /> Resources
        </h1>
        <p class="text-lg sm:text-xl text-primary-100/80 leading-relaxed max-w-2xl mx-auto reveal-up">
          Practical insights on software development, design, and technology for businesses in Ethiopia.
        </p>

        <!-- Post count -->
        <div class="mt-8 flex items-center justify-center gap-6 text-primary-200 text-sm reveal-up">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
            {posts.length} Articles
          </span>
          <span class="w-1 h-1 bg-primary-300 rounded-full"></span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
            {categories.length - 1} Categories
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="section-padding -mt-8 relative z-10">
      <div class="max-w-6xl mx-auto">
        <a href={`/blog/${featuredPost.id}/`} class="group block">
          <div class="bg-white rounded-2xl shadow-xl shadow-neutral-900/5 border border-neutral-200/60 overflow-hidden lg:grid lg:grid-cols-[1.2fr_1fr] hover:shadow-2xl hover:shadow-neutral-900/10 transition-all duration-500">
            <!-- Left: Gradient Visual -->
            <div class="relative aspect-[16/10] lg:aspect-auto bg-gradient-to-br from-primary-100 via-primary-50 to-secondary-50 flex items-center justify-center overflow-hidden">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(42,53,125,0.08),transparent_70%)]"></div>
              <div class="relative text-center px-8">
                <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-white/60 backdrop-blur-sm flex items-center justify-center shadow-lg">
                  <svg class="w-10 h-10 text-primary-400" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <span class="text-sm font-semibold text-primary-500/60 uppercase tracking-wider">Latest Article</span>
              </div>
              <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-200/50 to-transparent lg:hidden"></div>
            </div>

            <!-- Right: Content -->
            <div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1 ${featuredCat.bg} ${featuredCat.text} text-xs font-semibold rounded-full uppercase tracking-wider`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${featuredCat.dot}`}></span>
                  {featuredPost.data.category}
                </span>
                <span class="text-xs text-neutral-400">{featuredDate}</span>
              </div>

              <h2 class="text-xl sm:text-2xl lg:text-3xl font-display font-bold text-neutral-900 group-hover:text-primary-500 transition-colors leading-snug mb-4">
                {featuredPost.data.title}
              </h2>

              <p class="text-neutral-600 leading-relaxed mb-6 line-clamp-3">
                {featuredPost.data.description}
              </p>

              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 text-sm text-neutral-500">
                  <img src="/images/tinsae-avatar.webp" alt={featuredPost.data.author} class="w-7 h-7 rounded-full object-cover" loading="lazy" />
                  <span>{featuredPost.data.author}</span>
                  <span class="text-neutral-300">&middot;</span>
                  <span>{featuredPost.data.readTime}</span>
                </div>

                <span class="hidden sm:flex items-center gap-2 text-sm font-semibold text-primary-500 group-hover:gap-3 transition-all">
                  Read
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Category Filter -->
  <section class="section-padding mt-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin" id="category-filter">
        {categories.map((cat, i) => (
          <button
            class={`category-btn whitespace-nowrap px-4 py-2 text-sm font-medium rounded-full transition-all duration-300 ${i === 0 ? 'bg-primary-500 text-white shadow-md shadow-primary-500/20' : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200'}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="section-padding pt-8 pb-16">
    <div class="max-w-6xl mx-auto">
      <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {remainingPosts.map((post) => {
          const formattedDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
            year: 'numeric', month: 'short', day: 'numeric',
          });
          const catColor = categoryColors[post.data.category] || { bg: 'bg-primary-50', text: 'text-primary-600', dot: 'bg-primary-500' };

          return (
            <a href={`/blog/${post.id}/`} class="blog-card group block" data-category={post.data.category}>
              <div class="bg-white rounded-2xl border border-neutral-200/60 overflow-hidden h-full hover:shadow-xl hover:shadow-neutral-900/5 hover:-translate-y-1 transition-all duration-300">
                <!-- Card Image Area -->
                <div class="relative aspect-[16/10] bg-gradient-to-br from-primary-100 via-primary-50 to-secondary-50 overflow-hidden">
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-primary-200/40 via-transparent to-secondary-200/40"></div>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-14 h-14 rounded-xl bg-white/50 backdrop-blur-sm flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
                      <svg class="w-7 h-7 text-primary-300" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                    </div>
                  </div>
                  <!-- Read time badge -->
                  <div class="absolute top-3 right-3 px-2.5 py-1 bg-white/80 backdrop-blur-sm rounded-full text-xs font-medium text-neutral-600">
                    {post.data.readTime}
                  </div>
                </div>

                <!-- Card Content -->
                <div class="p-5 flex flex-col">
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 ${catColor.bg} ${catColor.text} text-xs font-semibold rounded-full`}>
                      <span class={`w-1 h-1 rounded-full ${catColor.dot}`}></span>
                      {post.data.category}
                    </span>
                    <span class="text-neutral-300">&middot;</span>
                    <span class="text-xs text-neutral-400">{formattedDate}</span>
                  </div>

                  <h2 class="text-lg font-bold text-neutral-900 group-hover:text-primary-500 transition-colors leading-snug mb-2">
                    {post.data.title}
                  </h2>

                  <p class="text-sm text-neutral-500 line-clamp-2 mb-4 flex-1">
                    {post.data.description}
                  </p>

                  <!-- Card Footer -->
                  <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
                    <div class="flex items-center gap-2">
                      <img src="/images/tinsae-avatar.webp" alt={post.data.author} class="w-6 h-6 rounded-full object-cover" loading="lazy" />
                      <span class="text-xs text-neutral-500">{post.data.author}</span>
                    </div>
                    <span class="flex items-center gap-1 text-xs font-semibold text-primary-500 opacity-0 group-hover:opacity-100 transition-opacity">
                      Read
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Empty state (hidden by default) -->
      <div id="empty-state" class="hidden text-center py-16">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-neutral-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-neutral-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9zm3.75 11.625a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
        </div>
        <p class="text-neutral-500">No articles found in this category yet.</p>
      </div>
    </div>
  </section>

  <CTA title="Need Expert Help with Your Project?" description="Our team is ready to help you build your next digital product." />
</BaseLayout>

<script>
  import { initScrollAnimations } from '@scripts/scroll-animations';
  initScrollAnimations();

  function initCategoryFilter() {
    const buttons = document.querySelectorAll('.category-btn') as NodeListOf<HTMLButtonElement>;
    const cards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('empty-state');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;

        buttons.forEach((b) => {
          b.classList.remove('bg-primary-500', 'text-white', 'shadow-md', 'shadow-primary-500/20');
          b.classList.add('bg-neutral-100', 'text-neutral-600');
        });
        btn.classList.remove('bg-neutral-100', 'text-neutral-600');
        btn.classList.add('bg-primary-500', 'text-white', 'shadow-md', 'shadow-primary-500/20');

        let visibleCount = 0;
        cards.forEach((card) => {
          const match = category === 'All' || card.dataset.category === category;
          card.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initCategoryFilter);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryFilter);
  } else {
    initCategoryFilter();
  }
</script>
