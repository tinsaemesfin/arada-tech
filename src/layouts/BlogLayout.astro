---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import CTA from '@components/global/CTA.astro';
import { brandAssets, company, siteConfig } from '@data/company';

interface RelatedPost {
  id: string;
  title: string;
  description: string;
  category: string;
  readTime: string;
  publishDate: string;
}

interface Props {
  title: string;
  description: string;
  publishDate: string;
  modifiedDate?: string;
  author?: string;
  category?: string;
  tags?: string[];
  readTime?: string;
  ogImage?: string;
  relatedPosts?: RelatedPost[];
}

const {
  title,
  description,
  publishDate,
  modifiedDate,
  author = company.ceo,
  category = 'Technology',
  tags = [],
  readTime = '5 min read',
  ogImage,
  relatedPosts = [],
} = Astro.props;

const breadcrumbs = [
  { name: 'Blog', href: '/blog/' },
  { name: title, href: Astro.url.pathname },
];

const canonicalPostUrl = new URL(Astro.url.pathname, Astro.site).href;
const postImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href)
  : new URL(siteConfig.defaultOgImage, Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: publishDate,
  dateModified: modifiedDate || publishDate,
  image: [postImageUrl],
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: company.name,
    url: company.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(brandAssets.fullLogo, Astro.site).href,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalPostUrl,
  },
};

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const authorInitials = author.split(' ').map(n => n[0]).join('');

const categoryColors: Record<string, { bg: string; text: string; dot: string }> = {
  Technology: { bg: 'bg-blue-50', text: 'text-blue-600', dot: 'bg-blue-500' },
  Business: { bg: 'bg-emerald-50', text: 'text-emerald-600', dot: 'bg-emerald-500' },
  Design: { bg: 'bg-purple-50', text: 'text-purple-600', dot: 'bg-purple-500' },
  Development: { bg: 'bg-orange-50', text: 'text-orange-600', dot: 'bg-orange-500' },
  'Mobile Development': { bg: 'bg-pink-50', text: 'text-pink-600', dot: 'bg-pink-500' },
};
const catColor = categoryColors[category] || { bg: 'bg-primary-50', text: 'text-primary-600', dot: 'bg-primary-500' };

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareTitle = encodeURIComponent(title);
const shareUrlEncoded = encodeURIComponent(shareUrl);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  article={{
    publishedTime: publishDate,
    modifiedTime: modifiedDate,
    author: author,
    section: category,
    tags: tags,
  }}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-indicator fixed top-0 left-0 h-[3px] bg-gradient-to-r from-primary-500 via-secondary-400 to-primary-500 z-50 transition-none max-w-full"></div>

  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Header -->
  <header class="relative overflow-hidden bg-gradient-to-br from-neutral-50 via-white to-primary-50/30">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary-100/40 blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 rounded-full bg-secondary-100/30 blur-3xl"></div>
      <svg class="absolute top-12 right-1/4 w-6 h-6 text-primary-200 opacity-60" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3" />
      </svg>
      <svg class="absolute bottom-16 left-1/3 w-4 h-4 text-secondary-200 opacity-50" fill="currentColor" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="3" />
      </svg>
    </div>

    <div class="section-padding relative">
      <div class="max-w-4xl mx-auto pt-4 pb-10 sm:pt-10 sm:pb-14 lg:pt-12 lg:pb-16">
        <!-- Category & Read Time -->
        <div class="flex items-center gap-3 mb-6">
          <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${catColor.bg} ${catColor.text} text-xs font-semibold rounded-full uppercase tracking-wider`}>
            <span class={`w-1.5 h-1.5 rounded-full ${catColor.dot}`}></span>
            {category}
          </span>
          <span class="text-sm text-neutral-400">&middot;</span>
          <span class="text-sm text-neutral-500 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {readTime}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-neutral-900 leading-tight mb-6 max-w-3xl">
          {title}
        </h1>

        <!-- Description -->
        <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed mb-8 max-w-2xl">
          {description}
        </p>

        <!-- Author & Date Row -->
        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-3">
            <img src="/images/tinsae-avatar.webp" alt={author} class="w-11 h-11 rounded-full object-cover shadow-md shadow-primary-500/20" loading="lazy" />
            <div>
              <p class="text-sm font-semibold text-neutral-900">{author}</p>
              <p class="text-xs text-neutral-500">CEO, {company.name}</p>
            </div>
          </div>

          <div class="hidden sm:block w-px h-8 bg-neutral-200"></div>

          <div class="flex items-center gap-2 text-sm text-neutral-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            <time datetime={publishDate}>{formattedDate}</time>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Divider -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neutral-200 to-transparent"></div>
  </header>

  {ogImage && (
    <div class="section-padding pt-8 sm:pt-10">
      <div class="max-w-4xl mx-auto">
        <img
          src={ogImage}
          alt={title}
          class="w-full rounded-2xl border border-neutral-200/60 shadow-lg shadow-neutral-900/5 object-cover"
        />
      </div>
    </div>
  )}

  <!-- Main Content Area -->
  <div class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12 xl:gap-16">

        <!-- Article Content -->
        <article class="min-w-0 py-10 sm:py-14">
          <div id="article-content" class="prose prose-lg prose-neutral max-w-none
            prose-headings:font-display prose-headings:tracking-tight prose-headings:scroll-mt-24
            prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-14 prose-h2:mb-5 prose-h2:pb-3 prose-h2:border-b prose-h2:border-neutral-100
            prose-h3:text-xl prose-h3:sm:text-2xl prose-h3:mt-10 prose-h3:mb-4
            prose-p:text-neutral-700 prose-p:leading-[1.8]
            prose-a:text-primary-500 prose-a:font-medium prose-a:no-underline prose-a:border-b prose-a:border-primary-200 hover:prose-a:border-primary-500 prose-a:transition-colors
            prose-strong:text-neutral-900 prose-strong:font-semibold
            prose-ul:text-neutral-700 prose-ol:text-neutral-700
            prose-li:leading-[1.8] prose-li:my-1
            prose-blockquote:border-l-4 prose-blockquote:border-primary-500 prose-blockquote:bg-primary-50/50 prose-blockquote:py-1 prose-blockquote:px-6 prose-blockquote:rounded-r-lg prose-blockquote:text-neutral-700 prose-blockquote:not-italic
            prose-code:text-primary-600 prose-code:bg-primary-50 prose-code:px-2 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm prose-code:font-medium prose-code:before:content-none prose-code:after:content-none
            prose-img:rounded-xl prose-img:shadow-lg
            prose-hr:border-neutral-200
          ">
            <slot />
          </div>

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="mt-14 pt-8 border-t border-neutral-200">
              <div class="flex items-start gap-3 flex-wrap">
                <span class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mt-1">Tags</span>
                <div class="flex items-center gap-2 flex-wrap">
                  {tags.map((tag) => (
                    <span class="px-3 py-1.5 bg-neutral-100 text-neutral-600 text-xs font-medium rounded-full hover:bg-neutral-200 transition-colors cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          )}

          <!-- Share Section -->
          <div class="mt-10 pt-8 border-t border-neutral-200">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <p class="text-sm font-semibold text-neutral-500 uppercase tracking-wider">Share this article</p>
              <div class="flex items-center gap-3">
                <a
                  href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrlEncoded}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-center w-10 h-10 rounded-full bg-neutral-100 text-neutral-500 hover:bg-[#1DA1F2] hover:text-white transition-all duration-300"
                  aria-label="Share on Twitter"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrlEncoded}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-center w-10 h-10 rounded-full bg-neutral-100 text-neutral-500 hover:bg-[#0077B5] hover:text-white transition-all duration-300"
                  aria-label="Share on LinkedIn"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <button
                  id="copy-link-btn"
                  class="group flex items-center gap-2 px-4 h-10 rounded-full bg-neutral-100 text-neutral-500 hover:bg-primary-500 hover:text-white transition-all duration-300 text-sm font-medium"
                  data-url={shareUrl}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.786-3.022a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 00-6.364 6.364l1.757 1.757" /></svg>
                  <span id="copy-link-text">Copy link</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Author Card -->
          <div class="mt-10 p-6 sm:p-8 bg-gradient-to-br from-neutral-50 to-primary-50/30 rounded-2xl border border-neutral-200/60">
            <div class="flex flex-col sm:flex-row items-start gap-5">
              <img src="/images/tinsae-avatar.webp" alt={author} class="flex-shrink-0 w-16 h-16 rounded-full object-cover shadow-lg shadow-primary-500/20" loading="lazy" />
              <div class="flex-1">
                <p class="text-xs font-semibold text-primary-500 uppercase tracking-wider mb-1">Written by</p>
                <p class="text-lg font-bold text-neutral-900 mb-1">{author}</p>
                <p class="text-sm text-neutral-600 leading-relaxed">
                  CEO and lead developer at {company.name}. Focused on shipping digital products that help Ethiopian businesses grow and compete globally.
                </p>
              </div>
            </div>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="hidden lg:block py-14">
          <div class="sticky top-24">
            <!-- Table of Contents -->
            <nav id="toc" class="mb-8">
              <p class="text-xs font-semibold text-neutral-400 uppercase tracking-widest mb-4">On this page</p>
              <ul id="toc-list" class="space-y-1 text-sm border-l-2 border-neutral-100">
              </ul>
            </nav>

            <!-- Back to Top -->
            <button
              id="back-to-top"
              class="w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-neutral-500 hover:text-primary-500 bg-neutral-50 hover:bg-primary-50 rounded-lg transition-all duration-300 opacity-0 translate-y-2 pointer-events-none"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
              Back to top
            </button>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="bg-neutral-50 border-t border-neutral-200">
      <div class="section-padding section-gap">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-10">
            <span class="text-sm font-semibold text-secondary-400 uppercase tracking-wider">Keep Reading</span>
            <h2 class="heading-md mt-2">Related Articles</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedPosts.map((rp) => {
              const rpDate = new Date(rp.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
              const rpCatColor = categoryColors[rp.category] || { bg: 'bg-primary-50', text: 'text-primary-600', dot: 'bg-primary-500' };
              return (
                <a href={`/blog/${rp.id}/`} class="group block bg-white rounded-2xl border border-neutral-200 overflow-hidden hover:shadow-xl hover:shadow-neutral-900/5 hover:-translate-y-1 transition-all duration-300">
                  <div class="relative aspect-[16/9] bg-gradient-to-br from-primary-100 via-primary-50 to-secondary-50 flex items-center justify-center overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent"></div>
                    <svg class="w-10 h-10 text-primary-200" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                  <div class="p-5">
                    <div class="flex items-center gap-2 mb-3">
                      <span class={`text-xs font-semibold ${rpCatColor.text}`}>{rp.category}</span>
                      <span class="text-neutral-300">&middot;</span>
                      <span class="text-xs text-neutral-400">{rpDate}</span>
                    </div>
                    <h3 class="text-base font-bold text-neutral-900 group-hover:text-primary-500 transition-colors leading-snug mb-2">{rp.title}</h3>
                    <p class="text-sm text-neutral-500 line-clamp-2">{rp.description}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )}

  <CTA
    title="Need Expert Development Help?"
    description="Our team in Addis Ababa is ready to help you build your next digital product."
    primaryText="Contact Us"
    primaryHref="/contact/"
    secondaryText="Explore Services"
    secondaryHref="/services/"
  />
</BaseLayout>

<script>
  import { initScrollAnimations } from '@scripts/scroll-animations';
  initScrollAnimations();

  function initBlogEnhancements() {
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');

    if (progressBar && article) {
      const updateProgress = () => {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const scrolled = window.scrollY - articleTop;
        const progress = Math.max(0, Math.min(100, (scrolled / (articleHeight - window.innerHeight)) * 100));
        progressBar.style.setProperty('--reading-progress-pct', `${progress}%`);
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // Table of Contents generation
    const tocList = document.getElementById('toc-list');
    const headings = article?.querySelectorAll('h2, h3');

    if (tocList && headings && headings.length > 0) {
      headings.forEach((heading, index) => {
        const id = heading.id || `heading-${index}`;
        heading.id = id;

        const li = document.createElement('li');
        const isH3 = heading.tagName === 'H3';
        li.innerHTML = `<a href="#${id}" class="toc-link block py-1.5 pl-4 ${isH3 ? 'pl-7' : ''} text-neutral-500 hover:text-primary-500 border-l-2 border-transparent hover:border-primary-300 transition-all duration-200" data-heading-id="${id}">${heading.textContent}</a>`;
        tocList.appendChild(li);
      });

      // Active heading tracking
      const tocLinks = tocList.querySelectorAll('.toc-link') as NodeListOf<HTMLElement>;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tocLinks.forEach((link) => {
                const isActive = link.dataset.headingId === entry.target.id;
                link.classList.toggle('text-primary-500', isActive);
                link.classList.toggle('font-medium', isActive);
                link.classList.toggle('border-primary-500', isActive);
                link.classList.toggle('text-neutral-500', !isActive);
                link.classList.toggle('border-transparent', !isActive);
              });
            }
          });
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );

      headings.forEach((heading) => observer.observe(heading));
    } else if (tocList) {
      const toc = document.getElementById('toc');
      if (toc) toc.classList.add('hidden');
    }

    // Back to top button
    const backToTop = document.getElementById('back-to-top');
    if (backToTop) {
      window.addEventListener('scroll', () => {
        const show = window.scrollY > 600;
        backToTop.classList.toggle('opacity-0', !show);
        backToTop.classList.toggle('translate-y-2', !show);
        backToTop.classList.toggle('pointer-events-none', !show);
        backToTop.classList.toggle('opacity-100', show);
        backToTop.classList.toggle('translate-y-0', show);
        backToTop.classList.toggle('pointer-events-auto', show);
      }, { passive: true });

      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Copy link button
    const copyBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
    const copyText = document.getElementById('copy-link-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.dataset.url || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyText.textContent = 'Copied!';
          copyBtn.classList.add('bg-primary-500', 'text-white');
          setTimeout(() => {
            copyText.textContent = 'Copy link';
            copyBtn.classList.remove('bg-primary-500', 'text-white');
          }, 2000);
        } catch {
          copyText.textContent = 'Failed';
          setTimeout(() => { copyText.textContent = 'Copy link'; }, 2000);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initBlogEnhancements);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogEnhancements);
  } else {
    initBlogEnhancements();
  }
</script>
