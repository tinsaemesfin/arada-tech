# ============================================
# Arada Tech — .htaccess (Apache + LiteSpeed/cPanel)
# ============================================
#
# Goals:
# - Real HTTP 404/410 for missing or retired URLs (no "soft 404" with 200).
# - Crawler / AI-bot friendly: never block by User-Agent, never rewrite robots,
#   sitemaps, or .well-known.
# - Safe on shared hosts: every directive that the host may forbid is wrapped
#   in <IfModule> so a missing module can never 500 the whole site (which
#   would in turn trigger the host's anti-bot CAPTCHA).
#
# IMPORTANT — about the "verify you are human" interstitial:
#   That challenge is produced by the HOST's WAF (LiteSpeed Anti-DDoS,
#   Imunify360, CSF, etc.), NOT by this file. .htaccess cannot turn it off.
#   To stop it for crawlers, ask the host to:
#     1) Whitelist Googlebot / Bingbot / GPTBot / ClaudeBot / PerplexityBot
#        IP ranges, or
#     2) Lower the bot-protection sensitivity for this domain, or
#     3) Disable LiteSpeed Anti-DDoS CAPTCHA in cPanel for this account.
#
# After deploy, verify:
#   curl -sI https://www.aradatech.com/
#   curl -sI https://www.aradatech.com/author/admin/        -> 410
#   curl -sI https://www.aradatech.com/nonexistent-12345/   -> 404
#   curl -sI https://www.aradatech.com/robots.txt           -> 200
#   curl -sI https://www.aradatech.com/sitemap-index.xml    -> 200
# ============================================

RewriteEngine On
RewriteBase /

# Prefer static index only (avoid stale index.php taking precedence)
DirectoryIndex index.html

# No directory listing; no MultiViews. Wrapped so a host that forbids
# Options overrides cannot 500 the site.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# ============================================
# Allow-list — these MUST always pass through untouched.
# Placed before any redirect/410 rule so nothing below can affect them.
# ============================================
RewriteRule ^robots\.txt$            - [L]
RewriteRule ^sitemap.*\.xml$         - [L]
RewriteRule ^ai\.txt$                - [L]
RewriteRule ^llms\.txt$              - [L]
RewriteRule ^llms-full\.txt$         - [L]
RewriteRule ^\.well-known/           - [L]
RewriteRule ^favicon\.ico$           - [L]

# ============================================
# HTTPS + www canonicalization — single 301, proxy-safe.
# Triggers when EITHER the request is plain HTTP OR the host is bare apex.
# Detects HTTPS via both %{HTTPS} and X-Forwarded-Proto (set by LiteSpeed
# edge / Cloudflare) so we never loop behind a TLS-terminating proxy.
# ============================================
RewriteCond %{HTTPS}                 !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https [OR]
RewriteCond %{HTTP_HOST}             ^aradatech\.com$ [NC]
RewriteRule ^(.*)$ https://www.aradatech.com/$1 [L,R=301]

# ============================================
# Retired WordPress / spam paths — 410 Gone
# (Faster drop from search than 404 for URLs that will never return.)
# ============================================
RewriteRule ^author(/|$)            - [G,L,NC]
RewriteRule ^category(/|$)          - [G,L,NC]
RewriteRule ^tag(/|$)               - [G,L,NC]
RewriteRule ^attachment(/|$)        - [G,L,NC]
RewriteRule ^page/\d+/?$            - [G,L,NC]
RewriteRule ^search(/|$)            - [G,L,NC]
RewriteRule ^trackback(/|$)         - [G,L,NC]
RewriteRule ^wp-json(/|$)           - [G,L,NC]
RewriteRule ^wc-api(/|$)            - [G,L,NC]
RewriteRule ^xmlrpc\.php$           - [G,L,NC]
RewriteRule ^comments/feed(/|$)     - [G,L,NC]
RewriteRule ^wp-[A-Za-z0-9_-]+/embed/?$ - [G,L,NC]

# Old WP admin/asset paths — also 410 (NOT a 301 to "/", which Google
# treats as a soft-404 and is harmful for SEO).
RewriteRule ^wp-admin(/|$)          - [G,L,NC]
RewriteRule ^wp-login\.php$         - [G,L,NC]
RewriteRule ^wp-content(/|$)        - [G,L,NC]
RewriteRule ^wp-includes(/|$)       - [G,L,NC]

# Sitemap aliases — only redirect if the target really exists (otherwise
# leave the 404 alone; chained 301→404 hurts crawl budget).
RewriteCond %{DOCUMENT_ROOT}/sitemap-index.xml -f
RewriteRule ^wp-sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/sitemap-index.xml -f
RewriteRule ^sitemap\.xml$    /sitemap-index.xml [R=301,L]

# Feed → blog listing (only if /blog/ exists)
RewriteCond %{DOCUMENT_ROOT}/blog/index.html -f
RewriteRule ^feed/?$     /blog/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/blog/index.html -f
RewriteRule ^feed/(.*)$  /blog/ [R=301,L]

# Legacy WP index entry
RewriteRule ^index\.php$ / [R=301,L]

# ============================================
# Error documents — MUST preserve status code
# (Local path = same status: 404 page + 404, or 410 page + 410.)
# Never replace this with: RewriteRule ... /404.html [L]  (that yields 200).
# ============================================
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ============================================
# Compression
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ============================================
# Browser caching
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html               "access plus 1 hour"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff   "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
  ExpiresByType application/xml         "access plus 1 hour"
  ExpiresByType application/json        "access plus 1 hour"
</IfModule>

# ============================================
# Security headers
# ============================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options   "nosniff"
  Header always set X-Frame-Options          "SAMEORIGIN"
  Header always set Referrer-Policy          "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy       "camera=(), microphone=(), geolocation=()"

  # Explicitly ALLOW indexing (some hosts inject X-Robots-Tag: noindex
  # by default on shared plans — overwrite it).
  Header always set X-Robots-Tag "all"

  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ============================================
# Protect sensitive files (anchored regex — no accidental matches)
# ============================================
<FilesMatch "^(\.htaccess|\.env|\.git.*|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|pnpm-lock\.yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
