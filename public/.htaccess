# ============================================
# Arada Tech — .htaccess (Apache + LiteSpeed/cPanel)
# ============================================
#
# Goals:
# - Real HTTP 404/410 for missing or retired URLs (no "soft 404" with 200).
# - Do NOT use an SPA-style catch-all that internally rewrites unknown paths to
#   index.html or 404.html — internal rewrites keep status 200 and break SEO.
#
# After deploy, verify:
#   curl -sI https://www.aradatech.com/
#   curl -sI https://www.aradatech.com/author/admin/
#   curl -sI https://www.aradatech.com/nonexistent-test-12345/
#
# Remove any leftover WordPress index.php + old WP .htaccess on the server, or
# requests may still be routed through PHP with 200 + theme "404" content.
# ============================================

RewriteEngine On

# Disable LiteSpeed CAPTCHA/bot verification for this site when enabled by the host.
<IfModule LiteSpeed>
  RewriteRule .* - [E=verifycaptcha:off]
</IfModule>

# Prefer static index only (avoid stale index.php taking precedence)
DirectoryIndex index.html

# No directory listing; no MultiViews (prevents odd content-negotiation matches)
Options -Indexes -MultiViews

# ============================================
# HTTPS and www canonicalization
# ============================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^aradatech\.com$ [NC]
RewriteRule ^(.*)$ https://www.aradatech.com/$1 [L,R=301]

# ============================================
# Retired WordPress / spam paths — 410 Gone
# (Faster drop from search than 404 for URLs that will never return.)
# ============================================
RewriteRule ^author/ - [G,L,NC]
RewriteRule ^category/ - [G,L,NC]
RewriteRule ^tag/ - [G,L,NC]
RewriteRule ^attachment/ - [G,L,NC]
RewriteRule ^page/\d+/?$ - [G,L,NC]
RewriteRule ^search/ - [G,L,NC]
RewriteRule ^trackback/ - [G,L,NC]
RewriteRule ^wp-json/ - [G,L,NC]
RewriteRule ^wc-api/ - [G,L,NC]
RewriteRule ^xmlrpc\.php$ - [G,L,NC]
RewriteRule ^comments/feed/ - [G,L,NC]
RewriteRule ^(.+)/embed/?$ - [G,L,NC]

# ============================================
# 301 — Old WordPress assets and feeds → useful equivalents
# ============================================
RewriteRule ^wp-admin(.*)$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^wp-content(.*)$ / [R=301,L]
RewriteRule ^wp-includes(.*)$ / [R=301,L]

RewriteRule ^wp-sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

# Main / category / tag feeds — blog listing is the closest replacement
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^feed/(.*)$ /blog/ [R=301,L]

# Legacy WP index entry
RewriteRule ^index\.php$ / [R=301,L]

# ============================================
# Error documents — MUST preserve status code
# (Local path = same status: 404 page + 404, or 410 page + 410.)
# Never replace this with: RewriteRule ... /404.html [L]  (that yields 200).
# ============================================
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ============================================
# Compression (Gzip/Deflate)
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================
# Browser caching
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ============================================
# Security headers
# ============================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ============================================
# Protect sensitive files
# ============================================
<FilesMatch "(^\.htaccess|\.env|\.git|composer\.json|package\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
